<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_afterlogin"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.futurecode.voicelockscreen.ui.afterlogin.HomeFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_settingFragment"
            app:destination="@id/settingFragment" />
        <action
            android:id="@+id/action_homeFragment_to_voiceSetupFragment"
            app:destination="@id/voiceSetupFragment" />
        <action
            android:id="@+id/action_homeFragment_to_permissionFragment"
            app:destination="@id/permissionFragment" />
        <action
            android:id="@+id/action_homeFragment_to_fingerprintLockFragment"
            app:destination="@id/fingerprintLockFragment" />
        <action
            android:id="@+id/action_homeFragment_to_screenPreviewFragment"
            app:destination="@id/screenPreviewFragment" />
        <action
            android:id="@+id/action_homeFragment_to_pinLockFragment"
            app:destination="@id/pinLockFragment" />
        <action
            android:id="@+id/action_homeFragment_to_patternLockFragment"
            app:destination="@id/patternLockFragment" />
        <action
            android:id="@+id/action_homeFragment_to_premiumFragment"
            app:destination="@id/premiumFragment" />
        <action
            android:id="@+id/action_homeFragment_to_seeAllthemesFragment"
            app:destination="@id/seeAllthemesFragment" />
        <action
            android:id="@+id/action_homeFragment_to_cameraVoiceFragment"
            app:destination="@id/cameraVoiceFragment" />
        <action
            android:id="@+id/action_homeFragment_to_themesFragment"
            app:destination="@id/themesFragment" />
        <action
            android:id="@+id/action_homeFragment_to_voiceNoteFragment"
            app:destination="@id/voiceNoteFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingFragment"
        android:name="com.futurecode.voicelockscreen.ui.afterlogin.SettingFragment"
        android:label="@string/settings"
        tools:layout="@layout/fragment_setting" />
    <fragment
        android:id="@+id/languageFragment"
        android:name="com.futurecode.voicelockscreen.ui.prelogin.LanguageFragment"
        android:label="@string/select_language"
        tools:layout="@layout/fragment_language" />
    <fragment
        android:id="@+id/fingerprintLockFragment"
        android:name="com.futurecode.voicelockscreen.ui.afterlogin.FingerprintLockFragment"
        android:label="@string/fingerprint_lock"
        tools:layout="@layout/fragment_fingerprint_lock" />
    <fragment
        android:id="@+id/voiceSetupFragment"
        android:name="com.futurecode.voicelockscreen.ui.afterlogin.VoiceSetupFragment"
        android:label="@string/voice_setup"
        tools:layout="@layout/fragment_voice_setup">

    </fragment>
    <fragment
        android:id="@+id/securityQuestionFragment"
        android:name="com.futurecode.voicelockscreen.ui.afterlogin.SecurityQuestionFragment"
        android:label="@string/setup_security_question"
        tools:layout="@layout/fragment_security_question" />
    <fragment
        android:id="@+id/screenPreviewFragment"
        android:name="com.futurecode.voicelockscreen.ui.afterlogin.ScreenPreviewFragment"
        android:label="@string/preview"
        tools:layout="@layout/view_lock_screen" />
    <fragment
        android:id="@+id/pinLockFragment"
        android:name="com.futurecode.voicelockscreen.ui.afterlogin.PinLockFragment"
        android:label="@string/pin_lock"
        tools:layout="@layout/fragment_pin_lock" />
    <fragment
        android:id="@+id/permissionFragment"
        android:name="com.futurecode.voicelockscreen.ui.afterlogin.PermissionFragment"
        android:label="@string/permissions_required"
        tools:layout="@layout/fragment_permission" />
    <fragment
        android:id="@+id/patternLockFragment"
        android:name="com.futurecode.voicelockscreen.ui.afterlogin.PatternLockFragment"
        android:label="@string/pattern_lock"
        tools:layout="@layout/fragment_pattern_lock" />
    <fragment
        android:id="@+id/premiumFragment"
        android:name="com.futurecode.voicelockscreen.ui.afterlogin.PremiumFragment"
        android:label="@string/premium_title"
        tools:layout="@layout/fragment_premium" />
    <fragment
        android:id="@+id/seeAllthemesFragment"
        android:name="com.futurecode.voicelockscreen.ui.afterlogin.SeeAllthemesFragment"
        android:label="@string/lock_screen_themes" />
    <fragment
        android:id="@+id/cameraVoiceFragment"
        android:name="com.futurecode.voicelockscreen.ui.afterlogin.CameraVoiceFragment"
        android:label="@string/open_camera_by_voice"
        tools:layout="@layout/fragment_camera_voice" />
    <fragment
        android:id="@+id/themesFragment"
        android:name="com.futurecode.voicelockscreen.ui.afterlogin.ThemesFragment"
        android:label="@string/tab_themes"
        tools:layout="@layout/fragment_themes" />
    <fragment
        android:id="@+id/aiQuoteFragment"
        android:name="com.futurecode.voicelockscreen.ui.afterlogin.AiQuoteFragment"
        android:label="@string/ai_quote"
        tools:layout="@layout/fragment_ai_quote" />
    <fragment
        android:id="@+id/voiceNoteFragment"
        android:name="com.futurecode.voicelockscreen.ui.afterlogin.VoiceNoteFragment"
        android:label="@string/tab_voice_note"
        tools:layout="@layout/fragment_voice_note" />
<fragment android:id="@+id/setupCompleteFragment" android:name="com.futurecode.voicelockscreen.ui.afterlogin.SetupCompleteFragment" android:label="@string/setup_done_title" /><fragment android:id="@+id/noteRecordFragment" android:name="com.futurecode.voicelockscreen.ui.afterlogin.NoteRecordFragment" android:label="@string/note_new_title" /><fragment android:id="@+id/noteDetailFragment" android:name="com.futurecode.voicelockscreen.ui.afterlogin.NoteDetailFragment" android:label="@string/note_detail_title" /><fragment android:id="@+id/customThemeFragment" android:name="com.futurecode.voicelockscreen.ui.afterlogin.CustomThemeFragment" android:label="@string/lock_screen_themes" /><fragment android:id="@+id/themePreviewFragment" android:name="com.futurecode.voicelockscreen.ui.afterlogin.ThemePreviewFragment" android:label="@string/preview" />
    <fragment
        android:id="@+id/successFragment"
        android:name="com.futurecode.voicelockscreen.ui.afterlogin.SuccessFragment"
        tools:layout="@layout/view_success_page" />
</navigation>
