<?xml version="1.0" encoding="utf-8"?>
<!-- Setup Success tick: seal pops in, check draws itself, a soft ring bursts out. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="120dp"
            android:height="120dp"
            android:viewportWidth="48"
            android:viewportHeight="48">

            <group
                android:name="ring"
                android:pivotX="24"
                android:pivotY="24"
                android:scaleX="0.6"
                android:scaleY="0.6">
                <path
                    android:name="ringPath"
                    android:fillColor="@android:color/transparent"
                    android:pathData="M24,24m-20,0a20,20 0,1 1,40 0a20,20 0,1 1,-40 0"
                    android:strokeAlpha="0"
                    android:strokeColor="@color/success"
                    android:strokeWidth="1.6" />
            </group>

            <group
                android:name="seal"
                android:pivotX="24"
                android:pivotY="24"
                android:scaleX="0"
                android:scaleY="0">
                <path
                    android:fillColor="@color/success"
                    android:pathData="M24.00,7.00L28.51,10.11L33.99,10.25L35.81,15.42L40.17,18.75L38.60,24.00L40.17,29.25L35.81,32.58L33.99,37.75L28.51,37.89L24.00,41.00L19.49,37.89L14.01,37.75L12.19,32.58L7.83,29.25L9.40,24.00L7.83,18.75L12.19,15.42L14.01,10.25L19.49,10.11Z"
                    android:strokeColor="@color/success"
                    android:strokeLineJoin="round"
                    android:strokeWidth="2.6" />
                <path
                    android:name="check"
                    android:fillColor="@android:color/transparent"
                    android:pathData="M16.5,24.6L21.6,29.6L31.8,18.8"
                    android:strokeColor="@color/white"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:strokeWidth="3.4"
                    android:trimPathEnd="0" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="seal">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="420"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="420"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="520"
                    android:interpolator="@android:anim/decelerate_interpolator"
                    android:propertyName="rotation"
                    android:valueFrom="-30"
                    android:valueTo="0" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="check">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="360"
                android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                android:propertyName="trimPathEnd"
                android:startOffset="340"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="ring">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="620"
                    android:interpolator="@android:anim/decelerate_interpolator"
                    android:propertyName="scaleX"
                    android:startOffset="300"
                    android:valueFrom="0.7"
                    android:valueTo="1.15" />
                <objectAnimator
                    android:duration="620"
                    android:interpolator="@android:anim/decelerate_interpolator"
                    android:propertyName="scaleY"
                    android:startOffset="300"
                    android:valueFrom="0.7"
                    android:valueTo="1.15" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="ringPath">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="620"
                android:propertyName="strokeAlpha"
                android:startOffset="300"
                android:valueFrom="0.9"
                android:valueTo="0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
