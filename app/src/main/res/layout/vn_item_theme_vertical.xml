<?xml version="1.0" encoding="utf-8"?>
<!-- Theme grid cell: rounded wallpaper thumbnail with an optional premium crown. -->
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@drawable/bg_wallpaper_card_surface"
    android:elevation="@dimen/elevation_card" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivTheme"
        android:layout_width="0dp"
        android:layout_height="@dimen/vn_dp_260"
        android:contentDescription="@string/preview"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/VN.RoundedImage_12" />

    <ImageView
        android:id="@+id/ivPremium"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_margin="@dimen/spacing_sm"
        android:background="@drawable/bg_premium_crown"
        android:contentDescription="@string/premium"
        android:padding="6dp"
        android:src="@drawable/ic_crown_simple"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/ivTheme"
        app:layout_constraintTop_toTopOf="@id/ivTheme"
        app:tint="@color/badge_pro_text" />
</androidx.constraintlayout.widget.ConstraintLayout>
