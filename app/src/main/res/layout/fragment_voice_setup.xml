<?xml version="1.0" encoding="utf-8"?>
<!-- Step 1 of the voice-lock setup, as in the reference: record -> "Your Voice Key" -> confirm twice. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vn_white">

    <include
        android:id="@+id/record"
        layout="@layout/vn_layout_voice_record" />

    <include
        android:id="@+id/result"
        layout="@layout/vn_layout_voice_result"
        android:visibility="gone" />

    <include
        android:id="@+id/confirm"
        layout="@layout/vn_layout_voice_confirm"
        android:visibility="gone" />
</FrameLayout>
