<?xml version="1.0" encoding="utf-8"?>
<!-- Themes tab: copy of the reference fragment_themes (ad slot removed), light scheme, violet accents. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="@dimen/vn_dp_44"
        android:layout_height="@dimen/vn_dp_44"
        android:layout_marginStart="@dimen/vn_dp_8"
        android:layout_marginTop="@dimen/vn_dp_8"
        android:contentDescription="@null"
        android:padding="@dimen/vn_dp_10"
        android:src="@drawable/vn_ic_logo_voice_lock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/VN.Headline_XSM_Medium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vn_dp_10"
        android:layout_marginEnd="@dimen/vn_dp_12"
        android:text="@string/tab_voice_lock"
        android:textColor="@color/vn_neutral01"
        app:layout_constraintBottom_toBottomOf="@id/ivLogo"
        app:layout_constraintEnd_toStartOf="@id/ivPremium"
        app:layout_constraintStart_toEndOf="@id/ivLogo"
        app:layout_constraintTop_toTopOf="@id/ivLogo" />

    <ImageView
        android:id="@+id/ivPremium"
        android:layout_width="@dimen/vn_dp_36"
        android:layout_height="@dimen/vn_dp_36"
        android:layout_marginEnd="@dimen/vn_dp_8"
        android:contentDescription="@string/upgrade_to_premium"
        android:src="@drawable/vn_ic_iap"
        app:layout_constraintBottom_toBottomOf="@id/ivSettings"
        app:layout_constraintEnd_toStartOf="@id/ivSettings"
        app:layout_constraintTop_toTopOf="@id/ivSettings" />

    <ImageView
        android:id="@+id/ivSettings"
        android:layout_width="@dimen/vn_dp_36"
        android:layout_height="@dimen/vn_dp_36"
        android:layout_marginEnd="@dimen/vn_dp_16"
        android:contentDescription="@string/setting"
        android:src="@drawable/vn_ic_setting"
        app:layout_constraintBottom_toBottomOf="@id/ivLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivLogo" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vn_dp_16"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/bottom_nav_content_inset"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivLogo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/vn_dp_36">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAiQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/vn_dp_16"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/vn_th_card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/vn_dp_20"
                        android:layout_marginTop="@dimen/vn_dp_20"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivAiQuote"
                            android:layout_width="@dimen/vn_dp_40"
                            android:layout_height="@dimen/vn_dp_40"
                            android:contentDescription="@null"
                            android:src="@drawable/vn_th_ic_ai_quote" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/vn_dp_16"
                            android:layout_marginEnd="@dimen/vn_dp_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvAiQuoteTitle"
                                style="@style/VN.Text_LG_SemiBold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ai_quote"
                                android:textColor="@color/vn_neutral01" />

                            <TextView
                                android:id="@+id/tvAiQuoteDesc"
                                style="@style/VN.Text_SM1_Regular"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/vn_th_ai_quote_desc"
                                android:textColor="@color/vn_neutral05" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivAiQuoteSparkle"
                            android:layout_width="@dimen/vn_dp_24"
                            android:layout_height="@dimen/vn_dp_24"
                            android:layout_marginEnd="@dimen/vn_dp_12"
                            android:contentDescription="@null"
                            android:src="@drawable/vn_ic_sparkle" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <!-- Sample-quote bubble (reference img_quote), built in code. -->
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="@dimen/vn_dp_72"
                            android:layout_marginStart="@dimen/vn_dp_16"
                            android:layout_marginTop="@dimen/vn_dp_12"
                            android:layout_marginEnd="@dimen/vn_dp_24"
                            android:layout_marginBottom="@dimen/vn_dp_8"
                            android:layout_weight="1">

                            <FrameLayout
                                android:layout_width="@dimen/vn_dp_239"
                                android:layout_height="match_parent"
                                android:background="@drawable/vn_th_bg_quote_bubble"
                                android:paddingStart="@dimen/vn_dp_14"
                                android:paddingTop="@dimen/vn_dp_12"
                                android:paddingEnd="@dimen/vn_dp_14"
                                android:paddingBottom="@dimen/vn_dp_14">

                                <ImageView
                                    android:layout_width="@dimen/vn_dp_12"
                                    android:layout_height="@dimen/vn_dp_12"
                                    android:layout_marginTop="@dimen/vn_dp_4"
                                    android:contentDescription="@null"
                                    android:src="@drawable/vn_ic_quote"
                                    app:tint="@color/vn_primary01" />

                                <TextView
                                    android:id="@+id/tvSampleQuote"
                                    style="@style/VN.Text_SM_Regular"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/vn_dp_18"
                                    android:layout_marginEnd="@dimen/vn_dp_14"
                                    android:fontFamily="@font/poppins_regular"
                                    android:lineSpacingExtra="@dimen/vn_dp_2"
                                    android:maxLines="2"
                                    android:ellipsize="end"
                                    android:text="@string/vn_th_sample_quote"
                                    android:textColor="@color/vn_primary01" />

                                <ImageView
                                    android:layout_width="@dimen/vn_dp_12"
                                    android:layout_height="@dimen/vn_dp_12"
                                    android:layout_gravity="bottom|end"
                                    android:contentDescription="@null"
                                    android:rotation="180"
                                    android:src="@drawable/vn_ic_quote"
                                    app:tint="@color/vn_primary01" />
                            </FrameLayout>
                        </FrameLayout>

                        <ImageView
                            android:id="@+id/btnAiQuoteNext"
                            android:layout_width="@dimen/vn_dp_40"
                            android:layout_height="@dimen/vn_dp_40"
                            android:layout_marginEnd="@dimen/vn_dp_12"
                            android:layout_marginBottom="@dimen/vn_dp_16"
                            android:background="@drawable/vn_bg_radius_1000_white"
                            android:contentDescription="@string/ai_quote"
                            android:padding="@dimen/vn_dp_6"
                            android:src="@drawable/vn_ic_arrow_right_gray"
                            app:tint="@color/vn_black" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLockScreenTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/vn_dp_16"
                android:layout_marginTop="@dimen/vn_dp_20"
                android:layout_marginBottom="@dimen/vn_dp_2"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/vn_th_card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/vn_dp_20"
                        android:layout_marginTop="@dimen/vn_dp_20"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivLockTheme"
                            android:layout_width="@dimen/vn_dp_40"
                            android:layout_height="@dimen/vn_dp_40"
                            android:contentDescription="@null"
                            android:src="@drawable/vn_th_ic_lock_theme" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/vn_dp_16"
                            android:layout_marginEnd="@dimen/vn_dp_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvLockThemeTitle"
                                style="@style/VN.Text_LG_SemiBold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/lock_screen_theme"
                                android:textColor="@color/vn_neutral01" />

                            <TextView
                                android:id="@+id/tvLockThemeDesc"
                                style="@style/VN.Text_SM1_Regular"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/vn_th_lock_theme_desc"
                                android:textColor="@color/vn_neutral05" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivLockThemeSparkle"
                            android:layout_width="@dimen/vn_dp_24"
                            android:layout_height="@dimen/vn_dp_24"
                            android:layout_marginEnd="@dimen/vn_dp_12"
                            android:contentDescription="@null"
                            android:src="@drawable/vn_ic_sparkle" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <!-- Two tilted phone previews (reference img_theme_photo), built from our theme images. -->
                        <FrameLayout
                            android:id="@+id/ivThemePhoto"
                            android:layout_width="@dimen/vn_dp_229"
                            android:layout_height="@dimen/vn_dp_90"
                            android:clipChildren="true"
                            android:clipToPadding="true">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivPhoneLeft"
                                android:layout_width="@dimen/vn_dp_70"
                                android:layout_height="@dimen/vn_dp_125"
                                android:layout_marginStart="@dimen/vn_dp_6"
                                android:layout_marginTop="@dimen/vn_dp_20"
                                android:contentDescription="@null"
                                android:padding="@dimen/vn_dp_2"
                                android:rotation="-32"
                                android:scaleType="centerCrop"
                                android:src="@drawable/theme_one"
                                app:shapeAppearanceOverlay="@style/VN.RoundedImage_16"
                                app:strokeColor="@color/vn_white"
                                app:strokeWidth="@dimen/vn_dp_2" />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivPhoneRight"
                                android:layout_width="@dimen/vn_dp_70"
                                android:layout_height="@dimen/vn_dp_125"
                                android:layout_marginStart="@dimen/vn_dp_100"
                                android:layout_marginTop="@dimen/vn_dp_8"
                                android:contentDescription="@null"
                                android:padding="@dimen/vn_dp_2"
                                android:rotation="32"
                                android:scaleType="centerCrop"
                                android:src="@drawable/theme_two"
                                app:shapeAppearanceOverlay="@style/VN.RoundedImage_16"
                                app:strokeColor="@color/vn_white"
                                app:strokeWidth="@dimen/vn_dp_2" />
                        </FrameLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:id="@+id/btnLockThemeNext"
                            android:layout_width="@dimen/vn_dp_40"
                            android:layout_height="@dimen/vn_dp_40"
                            android:layout_marginEnd="@dimen/vn_dp_12"
                            android:layout_marginBottom="@dimen/vn_dp_16"
                            android:background="@drawable/vn_bg_radius_1000_white"
                            android:contentDescription="@string/lock_screen_theme"
                            android:padding="@dimen/vn_dp_6"
                            android:src="@drawable/vn_ic_arrow_right_gray"
                            app:tint="@color/vn_black" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/include_bottom_tabs"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_sm"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
