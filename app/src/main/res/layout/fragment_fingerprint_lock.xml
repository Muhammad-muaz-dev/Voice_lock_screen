<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color"
    tools:context=".ui.afterlogin.FingerprintLockFragment">

    <!-- Header -->
    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_36sdp"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:background="@drawable/bg_circle_white"
        android:contentDescription="@string/back"
        android:padding="@dimen/_10sdp"
        android:src="@drawable/ic_back_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="@string/fingerprint_lock"
        android:textColor="@color/text_dark"
        android:textSize="@dimen/_18ssp"
        app:layout_constraintBottom_toBottomOf="@id/ivBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivBack" />

    <!-- Fingerprint Icon with Gradient Circle -->

    <FrameLayout
        android:id="@+id/flFingerprint"
        android:layout_width="@dimen/_150sdp"
        android:layout_height="@dimen/_150sdp"
        android:layout_marginTop="@dimen/_80sdp"
        android:background="@drawable/bg_fingerprint_circle"
        android:elevation="@dimen/_8sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

<!--        <ImageView-->
<!--            android:layout_width="@dimen/_140sdp"-->
<!--            android:layout_height="@dimen/_140sdp"-->
<!--            android:layout_gravity="center"-->
<!--            android:scaleType="center"-->
<!--            android:src="@drawable/ic_fingerprint"-->
<!--            android:contentDescription="@string/fingerprint_lock" />-->
    </FrameLayout>

    <!-- Enable Fingerprint Text -->
    <TextView
        android:id="@+id/tvEnableTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_40sdp"
        android:fontFamily="sans-serif-black"
        android:text="@string/enable_fingerprint_unlock"
        android:textColor="@color/text_dark"
        android:textSize="@dimen/_18ssp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/flFingerprint" />

    <TextView
        android:id="@+id/tvEnableDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:text="@string/use_fingerprint_desc"
        android:textColor="@color/text_gray"
        android:textSize="@dimen/_12ssp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEnableTitle" />

    <!-- Enable Fingerprint Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnEnable"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        android:background="@drawable/bg_onboarding_button"
        android:text="@string/enable_fingerprint"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="@dimen/_12ssp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toTopOf="@id/flAdContainer" />

    <!-- Ad Placeholder -->
    <FrameLayout
        android:id="@+id/flAdContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_60sdp"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        android:background="@drawable/bg_main_card"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:drawableStartCompat="@android:drawable/ic_menu_info_details"
            android:drawablePadding="@dimen/_4sdp"
            android:text="@string/advertisement"
            android:textColor="@color/text_gray"
            android:textSize="@dimen/_10ssp"
            app:drawableTint="@color/text_gray" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>