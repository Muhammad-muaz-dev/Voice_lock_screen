<?xml version="1.0" encoding="utf-8"?>
<!-- Theme Screen Lock: copy of the reference fragment_all_theme (ad slots removed), light scheme. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vn_white"
    android:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="@dimen/vn_dp_36"
        android:layout_height="@dimen/vn_dp_36"
        android:layout_marginStart="@dimen/vn_dp_12"
        android:layout_marginTop="@dimen/vn_dp_8"
        android:contentDescription="@string/back"
        android:src="@drawable/vn_ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/VN.Headline_XSM_Medium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vn_dp_12"
        android:layout_marginEnd="@dimen/vn_dp_16"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="@string/vn_text_theme_screen_lock"
        android:textColor="@color/vn_neutral01"
        app:layout_constraintBottom_toBottomOf="@id/ivBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        app:layout_constraintTop_toTopOf="@id/ivBack" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvThemes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/vn_dp_16"
        android:layout_marginTop="@dimen/vn_dp_12"
        android:layout_marginBottom="@dimen/vn_dp_6"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivBack" />
</androidx.constraintlayout.widget.ConstraintLayout>
