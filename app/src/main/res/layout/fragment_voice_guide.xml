<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg" android:paddingHorizontal="16dp" android:paddingBottom="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp" android:padding="12dp" android:background="@drawable/bg_header_circle_dark" android:src="@drawable/ic_pin_back" android:contentDescription="@string/back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:fontFamily="@font/sora_semibold" android:textSize="@dimen/text_titleL" android:textColor="@color/textPrimary" android:text="@string/setup_guide_title" android:lineHeight="28sp" app:lineHeight="28sp" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
            <TextView android:id="@+id/tvHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xxl" android:text="@string/setup_guide_heading" android:textSize="@dimen/text_titleS" android:fontFamily="@font/sora_semibold" android:textColor="@color/textPrimary" android:lineHeight="24sp" app:lineHeight="24sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_voice_card">
                <TextView android:id="@+id/tvVoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:text="@string/setup_guide_voice" android:textSize="@dimen/text_titleS" android:fontFamily="@font/sora_semibold" android:textColor="@color/textPrimary" android:lineHeight="24sp" app:lineHeight="24sp" />
                <TextView android:id="@+id/tvVoiceBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:text="@string/setup_guide_voice_body" android:textSize="@dimen/text_bodyM" android:fontFamily="@font/sora_regular" android:textColor="@color/textSecondary" android:lineHeight="20sp" app:lineHeight="20sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_voice_card">
                <TextView android:id="@+id/tvQuestion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:text="@string/setup_guide_question" android:textSize="@dimen/text_titleS" android:fontFamily="@font/sora_semibold" android:textColor="@color/textPrimary" android:lineHeight="24sp" app:lineHeight="24sp" />
                <TextView android:id="@+id/tvQuestionBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:text="@string/setup_guide_question_body" android:textSize="@dimen/text_bodyM" android:fontFamily="@font/sora_regular" android:textColor="@color/textSecondary" android:lineHeight="20sp" app:lineHeight="20sp" />
            </LinearLayout>
            <TextView android:id="@+id/tvPermissions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xxl" android:text="@string/setup_guide_permissions" android:textSize="@dimen/text_titleS" android:fontFamily="@font/sora_semibold" android:textColor="@color/textPrimary" android:lineHeight="24sp" app:lineHeight="24sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_voice_card">
                <TextView android:id="@+id/tvPermissionBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:text="@string/setup_guide_permissions_body" android:textSize="@dimen/text_bodyM" android:fontFamily="@font/sora_regular" android:textColor="@color/textSecondary" android:lineHeight="20sp" app:lineHeight="20sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="@dimen/spacing_md" android:gravity="center" android:fontFamily="@font/sora_bold" android:textSize="@dimen/text_buttonL" android:textColor="@color/text_white" android:background="@drawable/bg_cta_gradient" android:text="@string/start_voice_setup" android:clickable="true" android:focusable="true" android:lineHeight="24sp" app:lineHeight="24sp" />
</LinearLayout>