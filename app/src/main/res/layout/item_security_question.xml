<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:layout_marginBottom="12dp" android:padding="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/vn_bg_radius_16_neutral10">
