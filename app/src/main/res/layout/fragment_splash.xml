    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/splashProgressBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_1sdp"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:max="100"
        android:progress="0"
        android:indeterminate="true"
        app:trackThickness="@dimen/_6sdp"
        app:trackCornerRadius="@dimen/_10sdp"
        app:trackColor="#1FB6FF"
        app:indicatorColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="@dimen/_5sdp"
        app:layout_constraintBottom_toTopOf="@+id/setup_status"
        />

    <TextView
        android:id="@+id/setup_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center_horizontal"
        android:text="@string/setting_up_vice_security"
        android:textColor="#4D66C8"
        android:textSize="@dimen/_10ssp"
        app:layout_constraintBottom_toBottomOf="parent" />

