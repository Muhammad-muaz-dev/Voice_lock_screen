<?xml version="1.0" encoding="utf-8"?>
<!-- Recovery question picker, using the shared full-screen language-sheet layout. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vn_bg_bottom_sheet_dialog">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btnSheetClose"
        android:layout_width="@dimen/vn_dp_36"
        android:layout_height="@dimen/vn_dp_36"
        android:layout_marginStart="@dimen/vn_dp_8"
        android:layout_marginTop="@dimen/vn_dp_24"
        android:contentDescription="@string/close"
        android:src="@drawable/vn_ic_close_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSheetTitle"
        style="@style/VN.Headline_XSM_Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vn_dp_8"
        android:text="@string/pick_security_question"
        android:textColor="@color/vn_neutral01"
        app:layout_constraintBottom_toBottomOf="@id/btnSheetClose"
        app:layout_constraintStart_toEndOf="@id/btnSheetClose"
        app:layout_constraintTop_toTopOf="@id/btnSheetClose" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etSearch"
        style="@style/VN.Text_MD_Medium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/vn_dp_16"
        android:layout_marginTop="@dimen/vn_dp_12"
        android:background="@drawable/vn_bg_radius_1000_stroke_neutral07"
        android:drawablePadding="@dimen/vn_dp_8"
        android:drawableStart="@drawable/vn_ic_search"
        android:hint="@string/search_security_questions"
        android:inputType="text"
        android:padding="@dimen/vn_dp_12"
        android:textColor="@color/vn_neutral03"
        android:textColorHint="@color/vn_neutral05"
        app:drawableTint="@color/vn_neutral02"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSheetClose" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSheetQuestions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/vn_dp_16"
        android:layout_marginTop="@dimen/vn_dp_12"
        android:layout_marginBottom="@dimen/vn_dp_8"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/vn_dp_8"
        app:layout_constraintBottom_toTopOf="@id/btnSheetApply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etSearch"
        tools:itemCount="8"
        tools:listitem="@layout/item_recovery_question" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvNoQuestionsFound"
        style="@style/VN.Text_MD_Regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/security_question_no_matches"
        android:textColor="@color/vn_neutral05"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rvSheetQuestions"
        app:layout_constraintEnd_toEndOf="@id/rvSheetQuestions"
        app:layout_constraintStart_toStartOf="@id/rvSheetQuestions"
        app:layout_constraintTop_toTopOf="@id/rvSheetQuestions" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnSheetApply"
        style="@style/VN.Text_LG_SemiBold"
        android:layout_width="0dp"
        android:layout_height="@dimen/vn_dp_52"
        android:layout_marginHorizontal="@dimen/vn_dp_16"
        android:layout_marginBottom="@dimen/vn_dp_42"
        android:background="@drawable/vn_bg_gradient_btn_summary"
        android:gravity="center"
        android:text="@string/confirm_question"
        android:textColor="@color/vn_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
