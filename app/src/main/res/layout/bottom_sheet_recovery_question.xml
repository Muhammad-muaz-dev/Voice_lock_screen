<?xml version="1.0" encoding="utf-8"?>
<!-- Recovery question picker: close button, radio list with dividers, Apply. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top_rounded"
    android:paddingBottom="@dimen/spacing_xxl">

    <ImageView
        android:id="@+id/btnSheetClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/spacing_lg"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:background="@drawable/bg_close_circle"
        android:contentDescription="@string/close"
        android:padding="12dp"
        android:src="@drawable/ic_close_x"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSheetQuestions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/spacing_xxxl"
        android:layout_marginTop="@dimen/spacing_xs"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/btnSheetApply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSheetClose" />

    <TextView
        android:id="@+id/btnSheetApply"
        style="@style/Text.VoiceLock.buttonL"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="@dimen/spacing_xl"
        android:layout_marginTop="@dimen/spacing_lg"
        android:background="@drawable/bg_primary_pill_button"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/sora_semibold"
        android:gravity="center"
        android:text="@string/recovery_apply"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rvSheetQuestions" />
</androidx.constraintlayout.widget.ConstraintLayout>
