<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_voice_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/_20sdp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:text="@string/pattern_lock"
        android:textColor="#142242"
        android:textSize="@dimen/_18ssp" />

    <TextView
        android:id="@+id/tvPatternStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:gravity="center"
        android:text="@string/pattern_confirm_hint"
        android:textColor="@color/text_gray"
        android:textSize="@dimen/_10ssp" />

    <com.futurecode.voicelockscreen.ui.custom.PatternLockView
        android:id="@+id/patternView"
        android:layout_width="@dimen/_230sdp"
        android:layout_height="@dimen/_230sdp"
        android:layout_marginTop="@dimen/_12sdp" />
</LinearLayout>
