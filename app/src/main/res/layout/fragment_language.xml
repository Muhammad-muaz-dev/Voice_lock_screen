<?xml version="1.0" encoding="utf-8"?>
<!-- Language picker: title with a confirm check, then pill rows. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    tools:context=".ui.prelogin.LanguageFragment">

    <TextView
        android:id="@+id/tvTitle"
        style="@style/Text.VoiceLock.titleXL"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_lg"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:fontFamily="@font/sora_bold"
        android:text="@string/language"
        android:textColor="@color/primary_text"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@id/btnContinue"
        app:layout_constraintEnd_toStartOf="@id/btnContinue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnContinue" />

    <ImageView
        android:id="@+id/btnContinue"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/continue_text"
        android:src="@drawable/ic_language_done"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLanguages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_lg"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_lg"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/languageAdContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnContinue"
        tools:itemCount="10"
        tools:listitem="@layout/item_language" />

    <FrameLayout
        android:id="@+id/languageListOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:clipChildren="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/rvLanguages"
        app:layout_constraintEnd_toEndOf="@id/rvLanguages"
        app:layout_constraintStart_toStartOf="@id/rvLanguages"
        app:layout_constraintTop_toTopOf="@id/rvLanguages">

        <ImageView
            android:id="@+id/ivEnglishHint"
            android:layout_width="@dimen/language_hint_hand_width"
            android:layout_height="@dimen/language_hint_hand_height"
            android:layout_gravity="end|top"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/img_camera_tap_hand"
            android:visibility="gone"
            app:tint="@color/primary" />
    </FrameLayout>

    <!-- Native ad (preloaded on Splash). Hidden when off or not filled. -->
    <FrameLayout
        android:id="@+id/languageAdContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
