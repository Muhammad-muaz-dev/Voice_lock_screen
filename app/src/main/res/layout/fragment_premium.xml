<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    tools:context=".ui.afterlogin.PremiumFragment">

    <ImageButton
        android:id="@+id/ivClose"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_header_circle_dark"
        android:contentDescription="@string/close"
        android:padding="10dp"
        android:src="@drawable/ic_close_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/textPrimary" />

    <TextView
        android:id="@+id/tvRestore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/sora_regular"
        android:text="@string/restore"
        android:textColor="@color/primaryStart"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/ivClose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivClose" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/clBottom"
        app:layout_constraintTop_toBottomOf="@id/ivClose">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_pro_badge"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_pro_award" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/sora_bold"
                android:gravity="center"
                android:text="@string/pro_panel_title"
                android:textColor="@color/textPrimary"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/sora_regular"
                android:gravity="center"
                android:text="@string/pro_panel_subtitle"
                android:textColor="@color/textSecondary"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="24dp"
                    android:layout_height="1dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sora_regular"
                    android:gravity="center"
                    android:text="@string/premium"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sora_regular"
                    android:gravity="center"
                    android:text="@string/pro_basic"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mic_blue"
                    app:tint="@color/primaryStart" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/sora_regular"
                    android:text="@string/pro_feature_voice"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="58dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:padding="3dp"
                    android:src="@drawable/ic_check_small"
                    app:tint="@color/primaryStart" />

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:padding="3dp"
                    android:src="@drawable/ic_check_small"
                    app:tint="@color/primaryStart" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock_closed"
                    app:tint="@color/primaryStart" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/sora_regular"
                    android:text="@string/pro_feature_security"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="58dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:padding="3dp"
                    android:src="@drawable/ic_check_small"
                    app:tint="@color/primaryStart" />

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:padding="3dp"
                    android:src="@drawable/ic_check_small"
                    app:tint="@color/primaryStart" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_themes"
                    app:tint="@color/primaryStart" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/sora_regular"
                    android:text="@string/pro_feature_themes"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="58dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:padding="3dp"
                    android:src="@drawable/ic_check_small"
                    app:tint="@color/primaryStart" />

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:padding="3dp"
                    android:src="@drawable/ic_check_small"
                    app:tint="@color/primaryStart" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pro_support"
                    app:tint="@color/primaryStart" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/sora_regular"
                    android:text="@string/pro_feature_support"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="58dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:padding="3dp"
                    android:src="@drawable/ic_check_small"
                    app:tint="@color/primaryStart" />

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sora_bold"
                    android:gravity="center"
                    android:text="@string/pro_feature_unavailable"
                    android:textColor="@color/primaryStart"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pro_ads_off"
                    app:tint="@color/primaryStart" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/sora_regular"
                    android:text="@string/pro_feature_ads"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="58dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:padding="3dp"
                    android:src="@drawable/ic_check_small"
                    app:tint="@color/primaryStart" />

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sora_bold"
                    android:gravity="center"
                    android:text="@string/pro_feature_unavailable"
                    android:textColor="@color/primaryStart"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvPriceSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sora_regular"
            android:gravity="center"
            android:text="@string/pro_price_summary"
            android:textColor="@color/textSecondary"
            android:textSize="13sp"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPurchase"
            style="@style/Widget.VoiceLock.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/sora_bold"
            android:letterSpacing="0"
            android:text="@string/start_free_trial"
            android:textAllCaps="true"
            android:textSize="17sp"
            app:backgroundTint="@null"
            app:layout_constraintTop_toBottomOf="@id/tvPriceSummary"
            android:background="@drawable/bg_cta_gradient"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <TextView
            android:id="@+id/tvLegalDisclosure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/sora_regular"
            android:gravity="center"
            android:lineSpacingExtra="1dp"
            android:text="@string/pro_legal_disclosure"
            android:textColor="@color/textSecondary"
            android:textSize="11sp"
            app:layout_constraintTop_toBottomOf="@id/btnPurchase" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/successOverlay"
        layout="@layout/view_success_page"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
