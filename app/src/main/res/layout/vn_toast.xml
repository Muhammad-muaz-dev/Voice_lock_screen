<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/vn_dp_12"
    android:paddingEnd="@dimen/vn_dp_12">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vn_dp_52"
        android:background="@drawable/vn_bg_custom_toast"
        android:paddingStart="@dimen/vn_dp_16"
        android:paddingEnd="@dimen/vn_dp_16">

        <ImageView
            android:id="@+id/ivThumb"
            android:layout_width="@dimen/vn_dp_20"
            android:layout_height="@dimen/vn_dp_20"
            android:contentDescription="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvMessage"
            style="@style/VN.Text_MD_Regular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vn_dp_16"
            android:maxLines="2"
            android:textColor="@color/vn_neutral01"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/ivThumb"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_default="wrap" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
