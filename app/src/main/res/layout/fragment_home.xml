<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:clipToPadding="false"
    android:clipChildren="false"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/appBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_lg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvAppTitle"
            style="@style/Text.VoiceLock.titleXL"
            android:textSize="20sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sora_bold"
            android:text="@string/voice_lock"
            android:textColor="@color/primary_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <ImageView
            android:id="@+id/ivSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/primary_text"
            android:contentDescription="@string/settings"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Home Content -->
    <androidx.core.widget.NestedScrollView
        android:paddingTop="@dimen/card_shadow_gutter"
        android:clipChildren="false"
        android:id="@+id/homeScrollView"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/bottom_nav_content_inset"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/appBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:clipToPadding="false"
            android:clipChildren="false"
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingBottom="24dp">

            <!-- 1. Voice Screen Lock: mic orb with rings, title, toggle and status (no card). -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/voiceSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/spacing_sm"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <View
                    android:id="@+id/voiceRingOuter"
                    android:layout_width="137dp"
                    android:layout_height="137dp"
                    android:background="@drawable/bg_voice_orb_ring_outer"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/voiceRingInner"
                    android:layout_width="106dp"
                    android:layout_height="106dp"
                    android:background="@drawable/bg_voice_orb_ring_inner"
                    app:layout_constraintBottom_toBottomOf="@id/voiceRingOuter"
                    app:layout_constraintEnd_toEndOf="@id/voiceRingOuter"
                    app:layout_constraintStart_toStartOf="@id/voiceRingOuter"
                    app:layout_constraintTop_toTopOf="@id/voiceRingOuter" />

                <View
                    android:id="@+id/voicePulse2"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:alpha="0"
                    android:background="@drawable/bg_voice_wave"
                    app:layout_constraintBottom_toBottomOf="@id/voiceRingOuter"
                    app:layout_constraintEnd_toEndOf="@id/voiceRingOuter"
                    app:layout_constraintStart_toStartOf="@id/voiceRingOuter"
                    app:layout_constraintTop_toTopOf="@id/voiceRingOuter" />

                <View
                    android:id="@+id/voicePulse3"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:alpha="0"
                    android:background="@drawable/bg_voice_wave"
                    app:layout_constraintBottom_toBottomOf="@id/voiceRingOuter"
                    app:layout_constraintEnd_toEndOf="@id/voiceRingOuter"
                    app:layout_constraintStart_toStartOf="@id/voiceRingOuter"
                    app:layout_constraintTop_toTopOf="@id/voiceRingOuter" />

                <View
                    android:id="@+id/voicePulse"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:alpha="0"
                    android:background="@drawable/bg_voice_wave"
                    app:layout_constraintBottom_toBottomOf="@id/voiceRingOuter"
                    app:layout_constraintEnd_toEndOf="@id/voiceRingOuter"
                    app:layout_constraintStart_toStartOf="@id/voiceRingOuter"
                    app:layout_constraintTop_toTopOf="@id/voiceRingOuter" />

                <ImageView
                    android:id="@+id/voiceMic"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:background="@drawable/bg_camera_mic_circle"
                    android:clickable="true"
                    android:elevation="8dp"
                    android:focusable="true"
                    android:padding="25dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/vn_ic_mic_white"
                    app:layout_constraintBottom_toBottomOf="@id/voiceRingOuter"
                    app:layout_constraintEnd_toEndOf="@id/voiceRingOuter"
                    app:layout_constraintStart_toStartOf="@id/voiceRingOuter"
                    app:layout_constraintTop_toTopOf="@id/voiceRingOuter" />

                <TextView
                    android:id="@+id/tvVoiceTitle"
                    style="@style/Text.VoiceLock.titleXL"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_lg"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:fontFamily="@font/sora_semibold"
                    android:gravity="center"
                    android:text="@string/home_voice_title"
                    android:textColor="@color/primary_text"
                    android:textSize="20sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/voiceRingOuter" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchVoice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:contentDescription="@string/home_voice_title"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvVoiceTitle"
                    app:thumbTint="@drawable/selector_permission_thumb"
                    app:trackDecorationTint="@android:color/transparent"
                    app:trackTint="@drawable/selector_permission_track" />

                <TextView
                    android:id="@+id/tvVoiceSubtitle"
                    style="@style/Text.VoiceLock.bodyM"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_lg"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:fontFamily="@font/sora_regular"
                    android:gravity="center"
                    android:textColor="@color/textSecondary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/switchVoice"
                    tools:text="@string/home_voice_status_line_off" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 2. Other locks grid (2x2): Camera & PIN, then Pattern & Fingerprint -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCamera"
                style="@style/Widget.VoiceLock.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_md"
                app:layout_constraintTop_toBottomOf="@id/voiceSection"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/pinLock"
                app:layout_constraintHorizontal_chainStyle="spread">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/badgeCamera"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_feature_tile_camera"
                        android:src="@drawable/ic_feature_camera"
                        android:padding="12dp"
                        android:contentDescription="@null"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/chevronCamera"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_circle_chevron"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/primary"
                        android:padding="7dp"
                        android:contentDescription="@null"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvCameraTitle"
                        style="@style/Text.VoiceLock.titleS"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/sora_bold"
                        android:text="@string/open_camera_by_voice"
                        android:textColor="@color/primary_text"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/badgeCamera" />

                    <TextView
                        android:id="@+id/tvCameraSubtitle"
                        style="@style/Text.VoiceLock.caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/sora_regular"
                        android:text="@string/say_and_capture"
                        android:textColor="@color/secondary_text"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvCameraTitle"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pinLock"
                style="@style/Widget.VoiceLock.Card"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_md"
                app:layout_constraintTop_toTopOf="@id/cardCamera"
                app:layout_constraintBottom_toBottomOf="@id/cardCamera"
                app:layout_constraintStart_toEndOf="@id/cardCamera"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/badgePin"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_feature_tile_pin"
                        android:src="@drawable/ic_feature_pin"
                        android:padding="12dp"
                        android:contentDescription="@null"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/chevronPin"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_circle_chevron"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/primary"
                        android:padding="7dp"
                        android:contentDescription="@null"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPinTitle"
                        style="@style/Text.VoiceLock.titleS"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/sora_bold"
                        android:text="@string/pin_lock"
                        android:textColor="@color/primary_text"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/badgePin" />

                    <TextView
                        android:id="@+id/tvPinSubtitle"
                        style="@style/Text.VoiceLock.caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/sora_regular"
                        android:text="@string/set_a_pin_code"
                        android:textColor="@color/secondary_text"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvPinTitle"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/patternLock"
                style="@style/Widget.VoiceLock.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_md"
                app:layout_constraintTop_toBottomOf="@id/cardCamera"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/fingerLock"
                app:layout_constraintHorizontal_chainStyle="spread">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/badgePattern"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_feature_tile_pattern"
                        android:src="@drawable/ic_feature_pattern"
                        android:padding="12dp"
                        android:contentDescription="@null"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/chevronPattern"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_circle_chevron"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/primary"
                        android:padding="7dp"
                        android:contentDescription="@null"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPatternTitle"
                        style="@style/Text.VoiceLock.titleS"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/sora_bold"
                        android:text="@string/pattern_lock"
                        android:textColor="@color/primary_text"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/badgePattern" />

                    <TextView
                        android:id="@+id/tvPatternSubtitle"
                        style="@style/Text.VoiceLock.caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/sora_regular"
                        android:text="@string/draw_to_unlock"
                        android:textColor="@color/secondary_text"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvPatternTitle"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fingerLock"
                style="@style/Widget.VoiceLock.Card"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_md"
                app:layout_constraintTop_toTopOf="@id/patternLock"
                app:layout_constraintBottom_toBottomOf="@id/patternLock"
                app:layout_constraintStart_toEndOf="@id/patternLock"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/badgeFingerprint"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_feature_tile_fingerprint"
                        android:src="@drawable/ic_feature_fingerprint"
                        android:padding="12dp"
                        android:contentDescription="@null"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/chevronFingerprint"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_circle_chevron"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/primary"
                        android:padding="7dp"
                        android:contentDescription="@null"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvFingerprintTitle"
                        style="@style/Text.VoiceLock.titleS"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/sora_bold"
                        android:text="@string/fingerprint_lock"
                        android:textColor="@color/primary_text"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/badgeFingerprint" />

                    <TextView
                        android:id="@+id/tvFingerprintSubtitle"
                        style="@style/Text.VoiceLock.caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/sora_regular"
                        android:text="@string/use_biometrics"
                        android:textColor="@color/secondary_text"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvFingerprintTitle"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Lock Screen Themes Section -->
            <TextView
                android:id="@+id/tvThemesHeader"
                style="@style/Text.VoiceLock.titleM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/sora_bold"
                android:text="@string/lock_screen_themes"
                android:textColor="@color/primary_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/patternLock" />

            <TextView
                android:id="@+id/btnSeeAllThemes"
                style="@style/Text.VoiceLock.bodyS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sora_semibold"
                android:text="@string/see_all_arrow"
                android:textColor="@color/primary"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvThemesHeader"
                app:layout_constraintBottom_toBottomOf="@id/tvThemesHeader" />

            <androidx.recyclerview.widget.RecyclerView
                android:clipToPadding="false"
                android:clipChildren="false"
                android:paddingBottom="@dimen/card_shadow_gutter"
                android:paddingTop="@dimen/card_shadow_gutter"
                android:id="@+id/rvHomeThemes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/tvThemesHeader"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvHomeThemesMessage"
                style="@style/Text.VoiceLock.bodyS"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textColor="@color/textSecondary"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/rvHomeThemes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <View android:id="@+id/ivPremium" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/include_bottom_tabs"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_sm"
        app:layout_constraintBottom_toTopOf="@id/adBannerContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Home banner (remote config). Sits at the very bottom; the floating nav sits above it. -->
    <FrameLayout
        android:id="@+id/adBannerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
