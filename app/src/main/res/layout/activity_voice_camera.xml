<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">
    <TextureView
        android:id="@+id/livePreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cameraControls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/scrim"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/closeCamera"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/scrim"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toTopOf="@id/cameraStatus"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/closeCamera"
            android:layout_width="@dimen/spacing_max"
            android:layout_height="@dimen/spacing_max"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/spacing_md"
            android:src="@drawable/ic_close_x"
            android:contentDescription="@string/close"
            app:tint="@color/white"
            android:layout_marginStart="@dimen/spacing_lg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/cameraFlash"
            android:layout_width="@dimen/spacing_max"
            android:layout_height="@dimen/spacing_max"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/spacing_md"
            android:src="@drawable/ic_voice_camera_flash"
            android:contentDescription="@string/voice_camera_flash"
            app:tint="@color/white"
            android:layout_marginEnd="@dimen/spacing_lg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/cameraStatus"
            style="@style/Text.VoiceLock.bodyM"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:textColor="@color/white"
            android:gravity="center"
            android:accessibilityLiveRegion="polite"
            app:layout_constraintBottom_toTopOf="@id/cameraPhoto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/cameraPhoto"
            style="@style/Text.VoiceLock.buttonS"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/spacing_max"
            android:gravity="center"
            android:fontFamily="@font/sora_semibold"
            android:text="@string/voice_camera_photo"
            android:textColor="@color/white"
            android:background="@drawable/bg_voice_camera_mode"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="@dimen/spacing_xs"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintBottom_toTopOf="@id/cameraShutter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cameraVideo"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <TextView
            android:id="@+id/cameraVideo"
            style="@style/Text.VoiceLock.buttonS"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/spacing_max"
            android:gravity="center"
            android:fontFamily="@font/sora_semibold"
            android:text="@string/voice_camera_video"
            android:textColor="@color/white"
            android:background="@drawable/bg_voice_camera_mode"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="@id/cameraPhoto"
            app:layout_constraintStart_toEndOf="@id/cameraPhoto"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/cameraShutter"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginBottom="@dimen/spacing_xxl"
            android:background="@drawable/bg_voice_camera_shutter"
            android:contentDescription="@string/voice_camera_take_photo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/flipCamera"
            android:layout_width="@dimen/spacing_max"
            android:layout_height="@dimen/spacing_max"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/spacing_md"
            android:src="@drawable/ic_voice_camera_flip"
            android:contentDescription="@string/voice_camera_flip"
            app:tint="@color/white"
            android:layout_marginEnd="@dimen/spacing_xl"
            app:layout_constraintTop_toTopOf="@id/cameraShutter"
            app:layout_constraintBottom_toBottomOf="@id/cameraShutter"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
