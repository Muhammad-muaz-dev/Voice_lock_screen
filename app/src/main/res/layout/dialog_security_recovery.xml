<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingTop="88dp"
        android:paddingBottom="@dimen/spacing_xxl">

        <TextView
            android:id="@+id/recoveryQuestion"
            style="@style/Text.VoiceLock.titleM"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_credential_info"
            android:backgroundTint="@color/recovery_question_display"
            android:gravity="center"
            android:padding="@dimen/spacing_lg"
            android:textColor="@color/textPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/recoveryAnswer"
            style="@style/Text.VoiceLock.bodyL"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_credential_info"
            android:backgroundTint="@color/recovery_answer_fill"
            android:gravity="top|start"
            android:hint="@string/enter_your_answer"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="100"
            android:minHeight="200dp"
            android:padding="@dimen/spacing_lg"
            android:saveEnabled="false"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recoveryQuestion" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/recoveryApply"
            style="@style/Text.VoiceLock.buttonL"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:alpha="0.5"
            android:background="@drawable/bg_primary_pill_button"
            android:enabled="false"
            android:minHeight="@dimen/spacing_max"
            android:text="@string/recovery_apply"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recoveryAnswer" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
