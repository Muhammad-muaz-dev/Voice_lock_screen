<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">
    <TextView
        android:id="@+id/pinInfo"
        style="@style/Text.VoiceLock.bodyM"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/sora_regular"
        android:textColor="@color/textPrimary"
        android:background="@drawable/bg_credential_info"
        android:elevation="@dimen/elevation_card"
        android:padding="@dimen/spacing_lg"
        android:text="@string/pin_setup_info"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/pinLengths"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/pinInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_lg"
        app:singleSelection="true"
        app:selectionRequired="true">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pinLength4"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/spacing_max"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:fontFamily="@font/sora_semibold"
            android:text="@string/pin_length_4"
            android:saveEnabled="false"
            android:textAllCaps="false"
            android:textColor="@color/textPrimary"
            app:backgroundTint="@color/credential_segment_fill"
            app:cornerRadius="@dimen/radius_xl"
            app:iconGravity="textStart"
            app:iconSize="@dimen/spacing_md"
            app:iconTint="@color/primary_dark"
            app:strokeColor="@color/radioRing" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pinLength6"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/spacing_max"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:fontFamily="@font/sora_semibold"
            android:text="@string/pin_length_6"
            android:saveEnabled="false"
            android:textAllCaps="false"
            android:textColor="@color/textPrimary"
            app:backgroundTint="@color/credential_segment_fill"
            app:cornerRadius="@dimen/radius_xl"
            app:iconGravity="textStart"
            app:iconSize="@dimen/spacing_md"
            app:iconTint="@color/primary_dark"
            app:strokeColor="@color/radioRing" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/pinPrompt"
        style="@style/Text.VoiceLock.titleS"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/sora_semibold"
        android:textColor="@color/textPrimary"
        android:gravity="center"
        android:accessibilityLiveRegion="polite"
        android:text="@string/pin_setup_confirm_prompt"
        android:layout_marginTop="@dimen/spacing_md"
        app:layout_goneMarginTop="@dimen/spacing_lg"
        app:layout_constraintTop_toBottomOf="@id/pinLengths"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/pinEntryDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:importantForAccessibility="yes"
        app:layout_constraintTop_toBottomOf="@id/pinPrompt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_md" />

    <TextView
        android:id="@+id/entryKey1"
        style="@style/Text.VoiceLock.headline"
        android:layout_width="@dimen/credential_pin_key_size"
        android:layout_height="@dimen/credential_pin_key_size"
        android:layout_marginTop="@dimen/spacing_xl"
        app:layout_constraintTop_toBottomOf="@id/pinEntryDots"
        android:background="@drawable/bg_credential_key"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/entryKey2"
        app:layout_constraintHorizontal_chainStyle="spread"
        android:text="1"
        android:fontFamily="@font/sora_regular"
        android:textColor="@color/textPrimary"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/entryKey2"
        style="@style/Text.VoiceLock.headline"
        android:layout_width="@dimen/credential_pin_key_size"
        android:layout_height="@dimen/credential_pin_key_size"
        android:layout_marginTop="@dimen/spacing_xl"
        app:layout_constraintTop_toBottomOf="@id/pinEntryDots"
        android:background="@drawable/bg_credential_key"
        app:layout_constraintStart_toEndOf="@id/entryKey1"
        app:layout_constraintEnd_toStartOf="@id/entryKey3"
        android:text="2"
        android:fontFamily="@font/sora_regular"
        android:textColor="@color/textPrimary"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/entryKey3"
        style="@style/Text.VoiceLock.headline"
        android:layout_width="@dimen/credential_pin_key_size"
        android:layout_height="@dimen/credential_pin_key_size"
        android:layout_marginTop="@dimen/spacing_xl"
        app:layout_constraintTop_toBottomOf="@id/pinEntryDots"
        android:background="@drawable/bg_credential_key"
        app:layout_constraintStart_toEndOf="@id/entryKey2"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="3"
        android:fontFamily="@font/sora_regular"
        android:textColor="@color/textPrimary"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/entryKey4"
        style="@style/Text.VoiceLock.headline"
        android:layout_width="@dimen/credential_pin_key_size"
        android:layout_height="@dimen/credential_pin_key_size"
        android:layout_marginTop="@dimen/spacing_md"
        app:layout_constraintTop_toBottomOf="@id/entryKey1"
        android:background="@drawable/bg_credential_key"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/entryKey5"
        app:layout_constraintHorizontal_chainStyle="spread"
        android:text="4"
        android:fontFamily="@font/sora_regular"
        android:textColor="@color/textPrimary"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/entryKey5"
        style="@style/Text.VoiceLock.headline"
        android:layout_width="@dimen/credential_pin_key_size"
        android:layout_height="@dimen/credential_pin_key_size"
        android:layout_marginTop="@dimen/spacing_md"
        app:layout_constraintTop_toBottomOf="@id/entryKey2"
        android:background="@drawable/bg_credential_key"
        app:layout_constraintStart_toEndOf="@id/entryKey4"
        app:layout_constraintEnd_toStartOf="@id/entryKey6"
        android:text="5"
        android:fontFamily="@font/sora_regular"
        android:textColor="@color/textPrimary"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/entryKey6"
        style="@style/Text.VoiceLock.headline"
        android:layout_width="@dimen/credential_pin_key_size"
        android:layout_height="@dimen/credential_pin_key_size"
        android:layout_marginTop="@dimen/spacing_md"
        app:layout_constraintTop_toBottomOf="@id/entryKey3"
        android:background="@drawable/bg_credential_key"
        app:layout_constraintStart_toEndOf="@id/entryKey5"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="6"
        android:fontFamily="@font/sora_regular"
        android:textColor="@color/textPrimary"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/entryKey7"
        style="@style/Text.VoiceLock.headline"
        android:layout_width="@dimen/credential_pin_key_size"
        android:layout_height="@dimen/credential_pin_key_size"
        android:layout_marginTop="@dimen/spacing_md"
        app:layout_constraintTop_toBottomOf="@id/entryKey4"
        android:background="@drawable/bg_credential_key"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/entryKey8"
        app:layout_constraintHorizontal_chainStyle="spread"
        android:text="7"
        android:fontFamily="@font/sora_regular"
        android:textColor="@color/textPrimary"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/entryKey8"
        style="@style/Text.VoiceLock.headline"
        android:layout_width="@dimen/credential_pin_key_size"
        android:layout_height="@dimen/credential_pin_key_size"
        android:layout_marginTop="@dimen/spacing_md"
        app:layout_constraintTop_toBottomOf="@id/entryKey5"
        android:background="@drawable/bg_credential_key"
        app:layout_constraintStart_toEndOf="@id/entryKey7"
        app:layout_constraintEnd_toStartOf="@id/entryKey9"
        android:text="8"
        android:fontFamily="@font/sora_regular"
        android:textColor="@color/textPrimary"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/entryKey9"
        style="@style/Text.VoiceLock.headline"
        android:layout_width="@dimen/credential_pin_key_size"
        android:layout_height="@dimen/credential_pin_key_size"
        android:layout_marginTop="@dimen/spacing_md"
        app:layout_constraintTop_toBottomOf="@id/entryKey6"
        android:background="@drawable/bg_credential_key"
        app:layout_constraintStart_toEndOf="@id/entryKey8"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="9"
        android:fontFamily="@font/sora_regular"
        android:textColor="@color/textPrimary"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/entryKey0"
        style="@style/Text.VoiceLock.headline"
        android:layout_width="@dimen/credential_pin_key_size"
        android:layout_height="@dimen/credential_pin_key_size"
        android:layout_marginTop="@dimen/spacing_md"
        app:layout_constraintTop_toBottomOf="@id/entryKey8"
        android:background="@drawable/bg_credential_key"
        app:layout_constraintStart_toStartOf="@id/entryKey8"
        app:layout_constraintEnd_toEndOf="@id/entryKey8"
        android:text="0"
        android:fontFamily="@font/sora_regular"
        android:textColor="@color/textPrimary"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/entryKeyDelete"
        android:layout_width="@dimen/credential_pin_key_size"
        android:layout_height="@dimen/credential_pin_key_size"
        android:layout_marginTop="@dimen/spacing_md"
        app:layout_constraintTop_toBottomOf="@id/entryKey9"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintStart_toStartOf="@id/entryKey9"
        app:layout_constraintEnd_toEndOf="@id/entryKey9"
        android:padding="@dimen/spacing_xl"
        android:src="@drawable/ic_pin_backspace"
        android:contentDescription="@string/pin_setup_delete"
        app:tint="@color/textPrimary" />

    <TextView
        android:id="@+id/clearPin"
        style="@style/Text.VoiceLock.bodyM"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/sora_regular"
        android:textColor="@color/textPrimary"
        android:minHeight="@dimen/spacing_max"
        android:minWidth="@dimen/spacing_max"
        android:gravity="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:text="@string/pin_setup_clear"
        app:layout_constraintTop_toBottomOf="@id/entryKey0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_sm" />
</androidx.constraintlayout.widget.ConstraintLayout>
