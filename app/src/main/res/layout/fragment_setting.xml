<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/_20sdp">

        <!-- Toolbar -->
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:layout_marginStart="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:background="@drawable/bg_circle_white"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_back_blue"
            android:contentDescription="@string/back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSettingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting"
            android:textColor="@color/text_dark"
            android:textSize="@dimen/_18ssp"
            android:fontFamily="sans-serif-black"
            app:layout_constraintBottom_toBottomOf="@id/ivBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivBack" />

        <!-- Premium Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clPremium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_30sdp"
            android:background="@drawable/bg_premium_card"
            android:padding="@dimen/_16sdp"
            app:layout_constraintTop_toBottomOf="@id/ivBack">

            <LinearLayout
                android:id="@+id/llPremiumTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_main_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_8sdp"
                android:paddingVertical="@dimen/_4sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:src="@drawable/ic_crown"
                    app:tint="@color/premium_gold"
                    android:contentDescription="@string/premium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:text="@string/premium"
                    android:textColor="@color/text_dark"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvUpgradeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_12sdp"
                android:text="@string/upgrade_to_premium"
                android:textColor="@color/text_dark"
                android:textSize="@dimen/_16ssp"
                android:fontFamily="sans-serif-black"
                app:layout_constraintEnd_toStartOf="@id/ivPremiumShield"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/llPremiumTag" />

            <TextView
                android:id="@+id/tvPremiumDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:text="@string/premium_desc"
                android:textColor="@color/text_gray"
                android:textSize="@dimen/_9ssp"
                app:layout_constraintEnd_toEndOf="@id/tvUpgradeTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvUpgradeTitle" />

            <TextView
                android:id="@+id/btnUpgrade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/bg_premium_card"
                android:elevation="@dimen/_2sdp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_16sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:text="@string/upgrade_now"
                android:textColor="@color/blue_primary"
                android:textSize="@dimen/_10ssp"
                android:fontFamily="sans-serif-medium"
                app:drawableStartCompat="@drawable/ic_lightning"
                android:drawablePadding="@dimen/_4sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPremiumDesc" />

            <ImageView
                android:id="@+id/ivPremiumShield"
                android:layout_width="@dimen/_70sdp"
                android:layout_height="@dimen/_70sdp"
                android:background="@drawable/bg_shield_gradient"
                android:padding="@dimen/_16sdp"
                android:src="@drawable/ic_shield_white"
                android:contentDescription="@string/upgrade_to_premium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- General Settings Section -->
        <TextView
            android:id="@+id/tvGeneralSettingsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_24sdp"
            android:text="@string/general_settings"
            android:textColor="@color/text_gray"
            android:textSize="@dimen/_10ssp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clPremium" />

        <LinearLayout
            android:id="@+id/llGeneralSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_main_card"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_12sdp"
            app:layout_constraintTop_toBottomOf="@id/tvGeneralSettingsLabel">

            <!-- Change Language -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clChangeLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/_12sdp">

                <ImageView
                    android:id="@+id/ivIconLang"
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:background="@drawable/bg_icon_container"
                    android:padding="@dimen/_8sdp"
                    android:src="@drawable/ic_language_bubbles"
                    android:contentDescription="@string/change_language"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvLangTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:text="@string/change_language"
                    android:textColor="@color/text_dark"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintEnd_toStartOf="@id/ivChevron1"
                    app:layout_constraintStart_toEndOf="@id/ivIconLang"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/select_preferred_language"
                    android:textColor="@color/text_gray"
                    android:textSize="@dimen/_8ssp"
                    app:layout_constraintEnd_toEndOf="@id/tvLangTitle"
                    app:layout_constraintStart_toStartOf="@id/tvLangTitle"
                    app:layout_constraintTop_toBottomOf="@id/tvLangTitle" />

                <ImageView
                    android:id="@+id/ivChevron1"
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@string/change_language"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F5F5F5" />

            <!-- Change Security Question -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clSecurityQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/_12sdp">

                <ImageView
                    android:id="@+id/ivIconSecurity"
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:background="@drawable/bg_icon_container"
                    android:padding="@dimen/_8sdp"
                    android:src="@drawable/ic_security_question"
                    android:contentDescription="@string/change_security_question"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSecurityTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:text="@string/change_security_question"
                    android:textColor="@color/text_dark"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintEnd_toStartOf="@id/ivChevron2"
                    app:layout_constraintStart_toEndOf="@id/ivIconSecurity"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/update_account_recovery"
                    android:textColor="@color/text_gray"
                    android:textSize="@dimen/_8ssp"
                    app:layout_constraintEnd_toEndOf="@id/tvSecurityTitle"
                    app:layout_constraintStart_toStartOf="@id/tvSecurityTitle"
                    app:layout_constraintTop_toBottomOf="@id/tvSecurityTitle" />

                <ImageView
                    android:id="@+id/ivChevron2"
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@string/change_security_question"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F5F5F5" />

            <!-- Disable System Lock -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clDisableLock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/_12sdp">

                <ImageView
                    android:id="@+id/ivIconDisableLock"
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:background="@drawable/bg_icon_container"
                    android:padding="@dimen/_8sdp"
                    android:src="@drawable/ic_lock_blue"
                    android:contentDescription="@string/disable_system_lock"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvDisableLockTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:text="@string/disable_system_lock"
                    android:textColor="@color/text_dark"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintEnd_toStartOf="@id/ivChevron3"
                    app:layout_constraintStart_toEndOf="@id/ivIconDisableLock"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/avoid_multiple_lock"
                    android:textColor="@color/text_gray"
                    android:textSize="@dimen/_8ssp"
                    app:layout_constraintEnd_toEndOf="@id/tvDisableLockTitle"
                    app:layout_constraintStart_toStartOf="@id/tvDisableLockTitle"
                    app:layout_constraintTop_toBottomOf="@id/tvDisableLockTitle" />

                <ImageView
                    android:id="@+id/ivChevron3"
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@string/disable_system_lock"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>


        <include
            android:id="@+id/native_ads_3"
            layout="@layout/native_ads_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/_8sdp"
            app:layout_constraintTop_toBottomOf="@+id/llGeneralSettings"
            />

        <!-- Other Section -->
        <TextView
            android:id="@+id/tvOtherLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_24sdp"
            android:text="@string/other"
            android:textColor="@color/text_gray"
            android:textSize="@dimen/_10ssp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/native_ads_3" />

        <LinearLayout
            android:id="@+id/llOtherSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_main_card"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_12sdp"
            app:layout_constraintTop_toBottomOf="@id/tvOtherLabel">

            <!-- Share App -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clShareApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/_12sdp">

                <ImageView
                    android:id="@+id/ivIconShare"
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:background="@drawable/bg_icon_container"
                    android:padding="@dimen/_8sdp"
                    android:src="@drawable/ic_share_blue"
                    android:contentDescription="@string/share_app"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvShareTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:text="@string/share_app"
                    android:textColor="@color/text_dark"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintEnd_toStartOf="@id/ivChevron4"
                    app:layout_constraintStart_toEndOf="@id/ivIconShare"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/share_with_friends"
                    android:textColor="@color/text_gray"
                    android:textSize="@dimen/_8ssp"
                    app:layout_constraintEnd_toEndOf="@id/tvShareTitle"
                    app:layout_constraintStart_toStartOf="@id/tvShareTitle"
                    app:layout_constraintTop_toBottomOf="@id/tvShareTitle" />

                <ImageView
                    android:id="@+id/ivChevron4"
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@string/share_app"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F5F5F5" />

            <!-- Feedback -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/_12sdp">

                <ImageView
                    android:id="@+id/ivIconFeedback"
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:background="@drawable/bg_icon_container"
                    android:padding="@dimen/_8sdp"
                    android:src="@drawable/ic_feedback_blue"
                    android:contentDescription="@string/feedback"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvFeedbackTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:text="@string/feedback"
                    android:textColor="@color/text_dark"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintEnd_toStartOf="@id/ivChevron5"
                    app:layout_constraintStart_toEndOf="@id/ivIconFeedback"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/help_us_improve"
                    android:textColor="@color/text_gray"
                    android:textSize="@dimen/_8ssp"
                    app:layout_constraintEnd_toEndOf="@id/tvFeedbackTitle"
                    app:layout_constraintStart_toStartOf="@id/tvFeedbackTitle"
                    app:layout_constraintTop_toBottomOf="@id/tvFeedbackTitle" />

                <ImageView
                    android:id="@+id/ivChevron5"
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@string/feedback"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F5F5F5" />

            <!-- Privacy Policy -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clPrivacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/_12sdp">

                <ImageView
                    android:id="@+id/ivIconPrivacy"
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:background="@drawable/bg_icon_container"
                    android:padding="@dimen/_8sdp"
                    android:src="@drawable/ic_privacy_blue"
                    android:contentDescription="@string/privacy_policy"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvPrivacyTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:text="@string/privacy_policy"
                    android:textColor="@color/text_dark"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintEnd_toStartOf="@id/ivChevron6"
                    app:layout_constraintStart_toEndOf="@id/ivIconPrivacy"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/read_our_privacy"
                    android:textColor="@color/text_gray"
                    android:textSize="@dimen/_8ssp"
                    app:layout_constraintEnd_toEndOf="@id/tvPrivacyTitle"
                    app:layout_constraintStart_toStartOf="@id/tvPrivacyTitle"
                    app:layout_constraintTop_toBottomOf="@id/tvPrivacyTitle" />

                <ImageView
                    android:id="@+id/ivChevron6"
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@string/privacy_policy"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>