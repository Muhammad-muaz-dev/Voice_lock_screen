<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_settings_card"
    android:elevation="@dimen/elevation_card"
    android:padding="@dimen/spacing_xxl">

    <ImageView
        android:id="@+id/successMark"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:background="@drawable/bg_success_halo"
        android:importantForAccessibility="no"
        android:padding="@dimen/spacing_lg"
        android:src="@drawable/ic_pin_success_seal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/successTitle"
        style="@style/Text.VoiceLock.titleL"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:accessibilityHeading="true"
        android:fontFamily="@font/sora_bold"
        android:gravity="center"
        android:textColor="@color/textPrimary"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/successMark" />

    <TextView
        android:id="@+id/successDescription"
        style="@style/Text.VoiceLock.bodyM"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:fontFamily="@font/sora_regular"
        android:gravity="center"
        android:textColor="@color/textSecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/successTitle" />

    <TextView
        android:id="@+id/successAction"
        style="@style/Text.VoiceLock.buttonL"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xxl"
        android:background="@drawable/bg_cta_gradient"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/sora_bold"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="@dimen/spacing_max"
        android:padding="@dimen/spacing_md"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/successDescription" />
</androidx.constraintlayout.widget.ConstraintLayout>
