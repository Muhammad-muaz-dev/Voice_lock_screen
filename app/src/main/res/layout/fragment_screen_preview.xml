<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lock_preview_wallpaper"
    tools:context=".ui.afterlogin.ScreenPreviewFragment">


    <TextView
        android:id="@+id/tvStatusTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_28sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/_14ssp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="9:41" />

    <View
        android:id="@+id/topCircle"
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_44sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:layout_marginEnd="@dimen/_22sdp"
        android:background="@drawable/bg_preview_top_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/timeCard"
        android:layout_width="0dp"
        android:layout_height="@dimen/_100sdp"
        android:background="@drawable/bg_preview_time_card"
        android:gravity="center"
        android:padding="@dimen/_12sdp"
        android:orientation="vertical"
        android:layout_margin="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topCircle"
        >

        <TextView
            android:id="@+id/tvMainTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_35ssp"
            tools:text="17:07" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="#D5D0D7"
            android:textSize="@dimen/_15ssp"
            tools:text="Mon, 20 Jul" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvGreeting"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/bg_preview_greeting"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:paddingStart="@dimen/_22sdp"
        android:paddingEnd="@dimen/_22sdp"
        android:text="@string/good_afternoon"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/_14ssp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timeCard" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/unlockPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginEnd="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_82sdp"
        android:background="@drawable/bg_preview_unlock_panel"
        android:paddingStart="@dimen/_22sdp"
        android:paddingEnd="@dimen/_22sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.52"
        app:layout_constraintTop_toBottomOf="@+id/tvGreeting"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/micRings"
            android:layout_width="@dimen/_176sdp"
            android:layout_height="@dimen/_176sdp"
            android:layout_marginTop="@dimen/_42sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_preview_ring_outer" />

            <View
                android:layout_width="@dimen/_138sdp"
                android:layout_height="@dimen/_138sdp"
                android:layout_gravity="center"
                android:background="@drawable/bg_preview_ring_middle" />

            <View
                android:layout_width="@dimen/_102sdp"
                android:layout_height="@dimen/_102sdp"
                android:layout_gravity="center"
                android:background="@drawable/bg_preview_mic_circle" />

            <ImageView
                android:layout_width="@dimen/_54sdp"
                android:layout_height="@dimen/_54sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_preview_mic_white" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvSpeakHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:text="@string/tap_microphone"
            android:textColor="#B8B7C2"
            android:textSize="@dimen/_15ssp"
            app:layout_constraintBottom_toTopOf="@id/divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/micRings" />

        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginBottom="@dimen/_18sdp"
            android:background="#313346"
            app:layout_constraintBottom_toTopOf="@id/methodsRow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/methodsRow"
            android:layout_width="0dp"
            android:layout_height="@dimen/_106sdp"
            android:layout_marginBottom="@dimen/_24sdp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <include android:id="@+id/methodPin" layout="@layout/item_preview_method" />
            <include android:id="@+id/methodPattern" layout="@layout/item_preview_method" />
            <include android:id="@+id/methodVoice" layout="@layout/item_preview_method" />
            <include android:id="@+id/methodFingerprint" layout="@layout/item_preview_method" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_56sdp"
        android:layout_marginBottom="@dimen/_24sdp"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/settings"
        android:textColor="#A9A7B3"
        android:textSize="@dimen/_13ssp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/homeIndicator"
        android:layout_width="@dimen/_128sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_27sdp"
        android:background="@drawable/bg_preview_home_indicator"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvSecurity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_48sdp"
        android:layout_marginBottom="@dimen/_24sdp"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/security"
        android:textColor="#A9A7B3"
        android:textSize="@dimen/_13ssp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
