<?xml version="1.0" encoding="utf-8"?>
<!-- Recovery question row, styled like a selectable language row. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/vn_dp_12"
    android:background="@drawable/vn_bg_radius_16_neutral10"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="64dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvQuestion"
        style="@style/VN.Text_MD_Medium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/vn_dp_8"
        android:textColor="@color/vn_neutral03"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ivRadio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="What was the name of your first pet?" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivRadio"
        android:layout_width="@dimen/vn_dp_24"
        android:layout_height="@dimen/vn_dp_24"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_radio_off_ring"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
