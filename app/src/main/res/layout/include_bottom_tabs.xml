<?xml version="1.0" encoding="utf-8"?>
<!-- White full-width bottom navigation; selected state uses a violet icon and label. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_nav_bar"
    android:elevation="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:minHeight="64dp"
    android:padding="5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tabVoiceLock"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:contentDescription="@string/tab_voice_lock"
        android:focusable="true"
        android:minHeight="54dp"
        android:paddingHorizontal="@dimen/spacing_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tabThemes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/tabVoiceLockIcon"
            android:layout_width="26dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toTopOf="@id/tabVoiceLockLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <ImageView
                android:id="@+id/ivTabVoiceLock"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_voice_lock"
                app:tint="@color/primary_text" />
        </FrameLayout>

        <TextView
            android:id="@+id/tabVoiceLockLabel"
            style="@style/Text.VoiceLock.caption"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/sora_medium"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/tab_voice_lock"
            android:textColor="@color/primary_text"
            android:textSize="12sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeStepGranularity="0.5sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabVoiceLockIcon" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tabThemes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:contentDescription="@string/tab_themes"
        android:focusable="true"
        android:minHeight="54dp"
        android:paddingHorizontal="@dimen/spacing_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tabVoiceNote"
        app:layout_constraintStart_toEndOf="@id/tabVoiceLock"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/tabThemesIcon"
            android:layout_width="26dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toTopOf="@id/tabThemesLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <ImageView
                android:id="@+id/ivTabThemes"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_themes"
                app:tint="@color/primary_text" />
        </FrameLayout>

        <TextView
            android:id="@+id/tabThemesLabel"
            style="@style/Text.VoiceLock.caption"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/sora_medium"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/tab_themes"
            android:textColor="@color/primary_text"
            android:textSize="12sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeStepGranularity="0.5sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabThemesIcon" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tabVoiceNote"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:contentDescription="@string/tab_voice_note"
        android:focusable="true"
        android:minHeight="54dp"
        android:paddingHorizontal="@dimen/spacing_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tabThemes"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/tabVoiceNoteIcon"
            android:layout_width="26dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toTopOf="@id/tabVoiceNoteLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <ImageView
                android:id="@+id/ivTabVoiceNote"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_voice_notes"
                app:tint="@color/primary_text" />
        </FrameLayout>

        <TextView
            android:id="@+id/tabVoiceNoteLabel"
            style="@style/Text.VoiceLock.caption"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/sora_medium"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/tab_voice_note"
            android:textColor="@color/primary_text"
            android:textSize="12sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeStepGranularity="0.5sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabVoiceNoteIcon" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
