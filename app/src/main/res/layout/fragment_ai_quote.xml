<?xml version="1.0" encoding="utf-8"?>
<!-- AI Quote: copy of the reference fragment_select_quote (ad slots removed), light scheme, violet accents. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vn_white"
    android:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="@dimen/vn_dp_36"
        android:layout_height="@dimen/vn_dp_36"
        android:layout_marginStart="@dimen/vn_dp_8"
        android:layout_marginTop="@dimen/vn_dp_16"
        android:contentDescription="@string/back"
        android:src="@drawable/vn_ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvName"
        style="@style/VN.Headline_XSM_Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vn_dp_8"
        android:text="@string/ai_quote"
        android:textColor="@color/vn_neutral01"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTopics"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/vn_dp_16"
        android:layout_marginTop="@dimen/vn_dp_12"
        android:layout_marginBottom="@dimen/vn_dp_8"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/btnViewQuote"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <LinearLayout
        android:id="@+id/btnViewQuote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/vn_dp_16"
        android:layout_marginBottom="@dimen/vn_dp_8"
        android:background="@drawable/vn_bg_radius_1000_neutral09"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/vn_dp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/ivStar"
            android:layout_width="@dimen/vn_dp_20"
            android:layout_height="@dimen/vn_dp_20"
            android:contentDescription="@null"
            android:src="@drawable/vn_ic_quote_star"
            app:tint="@color/vn_neutral07" />

        <TextView
            android:id="@+id/tvViewYourQuote"
            style="@style/VN.Text_MD_SemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vn_dp_8"
            android:gravity="center"
            android:text="@string/vn_th_view_your_quote"
            android:textColor="@color/vn_neutral07" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
