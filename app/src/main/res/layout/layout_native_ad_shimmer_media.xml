<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ad_slot"
    android:importantForAccessibility="no">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/spacing_md">

        <com.futurecode.voicelockscreen.ads.NativeAdShimmerBlock
            android:id="@+id/adIconSkeleton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:shimmerCornerRadius="@dimen/radius_xs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/adHeadlineSkeleton"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/spacing_sm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/adIconSkeleton"
            app:layout_constraintTop_toTopOf="@id/adIconSkeleton">

            <com.futurecode.voicelockscreen.ads.NativeAdShimmerBlock
                android:layout_width="0dp"
                android:layout_height="12dp"
                app:shimmerCornerRadius="@dimen/radius_xs"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/adBodySkeleton"
            android:layout_width="0dp"
            android:layout_height="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/adHeadlineSkeleton"
            app:layout_constraintTop_toBottomOf="@id/adHeadlineSkeleton">

            <com.futurecode.voicelockscreen.ads.NativeAdShimmerBlock
                android:layout_width="0dp"
                android:layout_height="8dp"
                app:shimmerCornerRadius="@dimen/radius_xs"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/adHeaderBarrierSkeleton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="adIconSkeleton,adBodySkeleton" />

        <com.futurecode.voicelockscreen.ads.NativeAdShimmerBlock
            android:id="@+id/adMediaSkeleton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_sm"
            app:shimmerCornerRadius="@dimen/radius_xs"
            app:layout_constraintBottom_toTopOf="@id/adCallToActionSkeleton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_min="120dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/adHeaderBarrierSkeleton" />

        <com.futurecode.voicelockscreen.ads.NativeAdShimmerBlock
            android:id="@+id/adBadgeSkeleton"
            android:layout_width="24dp"
            android:layout_height="12dp"
            android:layout_margin="@dimen/spacing_xs"
            app:shimmerCornerRadius="@dimen/radius_xs"
            app:layout_constraintStart_toStartOf="@id/adMediaSkeleton"
            app:layout_constraintTop_toTopOf="@id/adMediaSkeleton" />

        <com.futurecode.voicelockscreen.ads.NativeAdShimmerBlock
            android:id="@+id/adCallToActionSkeleton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/spacing_sm"
            app:shimmerCornerRadius="@dimen/radius_xs"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/adMediaSkeleton" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
