<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_voice_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/_20sdp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:text="@string/pin_unlock"
        android:textColor="#142242"
        android:textSize="@dimen/_18ssp" />

    <LinearLayout
        android:id="@+id/pinDotsContainer"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:gravity="center"
        android:orientation="horizontal" />

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:columnCount="3"
        android:rowCount="4">

        <Button android:id="@+id/btnOne" style="@style/PinKeyButton" android:text="1" />
        <Button android:id="@+id/btnTwo" style="@style/PinKeyButton" android:text="2" />
        <Button android:id="@+id/btnThree" style="@style/PinKeyButton" android:text="3" />
        <Button android:id="@+id/btnFour" style="@style/PinKeyButton" android:text="4" />
        <Button android:id="@+id/btnFive" style="@style/PinKeyButton" android:text="5" />
        <Button android:id="@+id/btnSix" style="@style/PinKeyButton" android:text="6" />
        <Button android:id="@+id/btnSeven" style="@style/PinKeyButton" android:text="7" />
        <Button android:id="@+id/btnEight" style="@style/PinKeyButton" android:text="8" />
        <Button android:id="@+id/btnNine" style="@style/PinKeyButton" android:text="9" />
        <Button android:id="@+id/btnBackspace" style="@style/PinKeyButton" android:text="⌫" />
        <Button android:id="@+id/btnZero" style="@style/PinKeyButton" android:text="0" />

        <ImageButton
            android:id="@+id/btnConfirm"
            android:layout_width="@dimen/_67sdp"
            android:layout_height="@dimen/_46sdp"
            android:layout_margin="@dimen/_5sdp"
            android:background="@drawable/bg_pin_confirm"
            android:contentDescription="@string/confirm_pin"
            android:padding="@dimen/_15sdp"
            android:src="@drawable/ic_pin_check" />
    </GridLayout>
</LinearLayout>
