<?xml version="1.0" encoding="utf-8"?>
<!-- "Upload Image" grid header: copy of the reference item_upload_image. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/vn_white"
    app:cardCornerRadius="16dp"
    app:cardElevation="@dimen/elevation_card"
    app:strokeColor="@android:color/transparent">

    <LinearLayout
        android:id="@+id/containerUploadImage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vn_dp_112"
        android:background="@drawable/vn_bg_upload_image_dashed"
        android:gravity="center"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/vn_primary08"
            app:cardCornerRadius="100dp"
            app:cardElevation="0dp"
            app:strokeColor="@android:color/transparent">

            <ImageView
                android:id="@+id/ivUploadArrowHead"
                android:layout_width="@dimen/vn_dp_24"
                android:layout_height="@dimen/vn_dp_24"
                android:layout_margin="@dimen/vn_dp_12"
                android:importantForAccessibility="no"
                android:src="@drawable/vn_ic_upload"
                app:tint="@color/vn_neutral01" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvUploadImage"
            style="@style/VN.Text_SM_Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vn_dp_10"
            android:text="@string/vn_th_upload_image"
            android:textColor="@color/vn_neutral04" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
