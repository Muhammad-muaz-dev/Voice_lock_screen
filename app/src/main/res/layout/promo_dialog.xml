<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginHorizontal="@dimen/spacing_sm" android:gravity="center" android:orientation="vertical" android:background="@color/black" android:padding="@dimen/spacing_xl">
    <ImageView android:id="@+id/btn_close" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="end" android:src="@drawable/close" app:tint="@color/white" />
    <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="@string/promo_upgrade_diwali_bundle" android:textColor="@android:color/white" android:textSize="27dp" android:textStyle="normal" android:fontFamily="@font/sora_regular" android:letterSpacing="0" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/tvLimited" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="@string/limited_time_offer" android:textColor="@color/splash_accent_green" android:textSize="14dp" android:fontFamily="@font/sora_regular" android:letterSpacing="0" />
        <TextView android:id="@+id/tvTimer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_lg" android:gravity="center" android:text="@string/promo_initial_countdown" android:textColor="@color/white" android:textSize="14dp" android:fontFamily="@font/sora_regular" android:letterSpacing="0" />
    </LinearLayout>
    <TextView android:id="@+id/tvTitle2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:gravity="center" android:text="@string/promo_blue_flame_dra" android:textColor="@color/textSecondary" android:textSize="22dp" android:textStyle="normal" android:fontFamily="@font/sora_regular" android:letterSpacing="0" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:gravity="center" android:lineSpacingExtra="1dp" android:textColor="@color/textSecondary" android:text="@string/claim_reward_now" android:textSize="13dp" android:fontFamily="@font/sora_regular" android:letterSpacing="0" />
    <ImageView android:id="@+id/imgBanner" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="@dimen/spacing_lg" android:scaleType="fitXY" android:src="@drawable/inapp1" />
    <Button android:id="@+id/btnUpgrade" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="@dimen/spacing_xl" android:layout_marginBottom="@dimen/spacing_sm" android:background="@drawable/bg_onboarding_button" android:text="@string/upgrade" app:backgroundTint="@null" android:textColor="@android:color/white" android:textSize="@dimen/text_buttonL" android:fontFamily="@font/sora_bold" android:letterSpacing="0" android:insetTop="0dp" android:insetBottom="0dp" android:lineHeight="24sp" app:lineHeight="24sp" />
    <TextView android:id="@+id/btnMaybeLater" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:layout_marginBottom="@dimen/spacing_xxxl" android:gravity="center" android:text="@string/maybe_later" android:textColor="@android:color/white" android:textSize="11dp" android:fontFamily="@font/sora_regular" android:letterSpacing="0" />
</LinearLayout>