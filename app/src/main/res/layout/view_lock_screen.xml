<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:clipToPadding="false"
    android:clipChildren="false"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">
    <ImageView
        android:id="@+id/imgWallpaper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:src="@drawable/lock_preview_wallpaper"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:paddingBottom="@dimen/card_shadow_gutter"
        android:paddingTop="@dimen/card_shadow_gutter"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:clipToPadding="false"
            android:clipChildren="false"
            android:id="@+id/lockContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/spacing_xxl">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/lockHelp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/vn_ic_question_lock_screen"
                android:contentDescription="@string/lock_screen_help"
                android:background="@drawable/bg_lock_shortcut"
                android:padding="@dimen/spacing_xs"
                app:tint="@color/white"
                android:layout_marginEnd="@dimen/spacing_lg"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:elevation="@dimen/elevation_card"
                android:id="@+id/timeCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lockHelp"
                android:layout_marginTop="@dimen/spacing_xxxl"
                app:layout_constraintWidth_percent="0.40"
                android:background="@drawable/bg_lock_content_panel"
                android:padding="@dimen/spacing_lg">
                <TextView
                    android:id="@+id/tvMainTime"
                    style="@style/Text.VoiceLock.clock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:fontFamily="@font/sora_bold"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvDate"
                    style="@style/Text.VoiceLock.bodyL"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:fontFamily="@font/sora_semibold"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvMainTime"
                    android:layout_marginTop="@dimen/spacing_md" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvGreeting"
                style="@style/Text.VoiceLock.titleS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="@font/sora_semibold"
                android:textColor="@color/white"
                android:text="@string/good_afternoon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/timeCard"
                android:layout_marginTop="@dimen/spacing_xxl"
                app:layout_constrainedWidth="true"
                android:background="@drawable/bg_lock_content_panel"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:paddingVertical="@dimen/spacing_xs" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:elevation="@dimen/elevation_card"
                android:id="@+id/quoteCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvGreeting"
                android:layout_marginTop="@dimen/spacing_sm"
                app:layout_constraintWidth_percent="0.79"
                android:background="@drawable/bg_lock_content_panel"
                android:padding="@dimen/spacing_lg">
                <ImageView
                    android:layout_width="@dimen/spacing_lg"
                    android:layout_height="@dimen/spacing_lg"
                    android:src="@drawable/vn_ic_quote"
                    android:importantForAccessibility="no"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvQuote"
                    style="@style/Text.VoiceLock.titleS"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:fontFamily="@font/sora_regular"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginHorizontal="@dimen/spacing_lg"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textStyle="italic" />
            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lockShortcuts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxl"
                app:layout_constraintBottom_toTopOf="@id/micRings"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/quoteCard"
                app:layout_constraintWidth_percent="0.70">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/methodPin"
                    android:layout_width="@dimen/lock_shortcut_size"
                    android:layout_height="@dimen/lock_shortcut_size"
                    android:background="@drawable/bg_lock_shortcut"
                    android:contentDescription="@string/pin"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/spacing_md"
                    android:src="@drawable/vn_ic_pin_lock_screen"
                    app:layout_constraintEnd_toStartOf="@id/methodPattern"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:tint="@color/white" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/methodPattern"
                    android:layout_width="@dimen/lock_shortcut_size"
                    android:layout_height="@dimen/lock_shortcut_size"
                    android:background="@drawable/bg_lock_shortcut"
                    android:contentDescription="@string/pattern"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/spacing_md"
                    android:src="@drawable/vn_ic_pattern_lock_screen"
                    app:layout_constraintEnd_toStartOf="@id/methodFingerprint"
                    app:layout_constraintStart_toEndOf="@id/methodPin"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:tint="@color/white" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/methodFingerprint"
                    android:layout_width="@dimen/lock_shortcut_size"
                    android:layout_height="@dimen/lock_shortcut_size"
                    android:background="@drawable/bg_lock_shortcut"
                    android:contentDescription="@string/fingerprint"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/spacing_md"
                    android:src="@drawable/vn_ic_fingerprint_lock_screen"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/methodPattern"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:tint="@color/white" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/micRings"
                android:layout_width="@dimen/lock_mic_size"
                android:layout_height="@dimen/lock_mic_size"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_preview_mic_circle"
                android:contentDescription="@string/tap_microphone"
                android:padding="@dimen/spacing_md"
                android:src="@drawable/ic_preview_mic_white"
                app:layout_constraintBottom_toTopOf="@+id/tvSpeakHint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvSpeakHint"
                style="@style/Text.VoiceLock.titleS"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_xl"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="@font/sora_regular"
                android:gravity="center"
                android:shadowColor="@color/black"
                android:shadowRadius="4"
                android:text="@string/tap_microphone"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
               />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
