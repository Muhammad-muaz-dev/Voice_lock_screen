<?xml version="1.0" encoding="utf-8"?>
<!--
    Permissions Required (same design as the camera flow). PermissionFragment shows only the
    rows the calling flow needs: voice = microphone + phone + overlay; PIN/pattern/fingerprint = phone + overlay.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    android:clipToPadding="false"
    android:clipChildren="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    tools:context=".ui.afterlogin.PermissionFragment">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/spacing_lg"
        android:layout_marginTop="@dimen/spacing_md"
        android:background="@drawable/bg_camera_back"
        android:contentDescription="@string/back"
        android:padding="12dp"
        android:src="@drawable/ic_back_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/primary_text" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/Text.VoiceLock.titleXL"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:fontFamily="@font/sora_medium"
        android:maxLines="1"
        android:text="@string/permissions_required"
        android:textColor="@color/primary_text"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@id/ivBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        app:layout_constraintTop_toTopOf="@id/ivBack" />

    <androidx.core.widget.NestedScrollView
        android:paddingTop="@dimen/card_shadow_gutter"
        android:clipChildren="true"
        android:id="@+id/permissionScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/spacing_lg"
        app:layout_constraintBottom_toTopOf="@id/btnContinue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivBack">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:clipToPadding="false"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_lg">

            <ImageView
                android:id="@+id/ivShield"
                android:layout_width="156dp"
                android:layout_height="156dp"
                android:layout_marginTop="@dimen/spacing_xs"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/img_camera_permission_hero"
                app:tint="@color/primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvMainTitle"
                style="@style/Text.VoiceLock.titleL"
                android:textSize="20sp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:fontFamily="@font/sora_medium"
                android:gravity="center"
                android:text="@string/camera_permissions_heading"
                android:textColor="@color/primary_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivShield" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:elevation="@dimen/elevation_card"
                android:id="@+id/llPermissions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxl"
                android:background="@drawable/bg_camera_surface_card"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingVertical="@dimen/spacing_md"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvMainTitle">

                <!-- Microphone (voice flows only) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clMicrophonePermission"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:minHeight="72dp"
                    android:paddingVertical="@dimen/spacing_xs"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <FrameLayout
                        android:id="@+id/ivIconMicrophoneContainer"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_camera_icon_circle"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_camera_mic_outline"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvMicrophoneTitle"
                        style="@style/Text.VoiceLock.titleS"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:fontFamily="@font/sora_medium"
                        android:text="@string/microphone_access"
                        android:textColor="@color/primary_text"
                        app:layout_constraintBottom_toTopOf="@id/tvMicrophoneDesc"
                        app:layout_constraintEnd_toStartOf="@id/swMicrophone"
                        app:layout_constraintStart_toEndOf="@id/ivIconMicrophoneContainer"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tvMicrophoneDesc"
                        style="@style/Text.VoiceLock.bodyS"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:fontFamily="@font/sora_regular"
                        android:text="@string/camera_microphone_access_desc"
                        android:textColor="@color/textSecondary"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tvMicrophoneTitle"
                        app:layout_constraintStart_toStartOf="@id/tvMicrophoneTitle"
                        app:layout_constraintTop_toBottomOf="@id/tvMicrophoneTitle" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swMicrophone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/microphone_access"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:thumbTint="@drawable/selector_permission_thumb_card"
                        app:trackDecorationTint="@android:color/transparent"
                        app:trackTint="@drawable/selector_permission_track_card" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Phone -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clPhonePermission"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:minHeight="72dp"
                    android:paddingVertical="@dimen/spacing_xs"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/clMicrophonePermission">

                    <FrameLayout
                        android:id="@+id/ivIconPhoneContainer"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_camera_icon_circle"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_perm_phone"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvPhoneTitle"
                        style="@style/Text.VoiceLock.titleS"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:fontFamily="@font/sora_medium"
                        android:text="@string/phone_call_access"
                        android:textColor="@color/primary_text"
                        app:layout_constraintBottom_toTopOf="@id/tvPhoneDesc"
                        app:layout_constraintEnd_toStartOf="@id/swPhone"
                        app:layout_constraintStart_toEndOf="@id/ivIconPhoneContainer"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tvPhoneDesc"
                        style="@style/Text.VoiceLock.bodyS"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:fontFamily="@font/sora_regular"
                        android:text="@string/phone_call_desc"
                        android:textColor="@color/textSecondary"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tvPhoneTitle"
                        app:layout_constraintStart_toStartOf="@id/tvPhoneTitle"
                        app:layout_constraintTop_toBottomOf="@id/tvPhoneTitle" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/phone_call_access"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:thumbTint="@drawable/selector_permission_thumb_card"
                        app:trackDecorationTint="@android:color/transparent"
                        app:trackTint="@drawable/selector_permission_track_card" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Display over other apps -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clDisplayPermission"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:minHeight="72dp"
                    android:paddingVertical="@dimen/spacing_xs"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/clPhonePermission">

                    <FrameLayout
                        android:id="@+id/ivIconDisplayContainer"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_camera_icon_circle"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_camera_layers"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvDisplayTitle"
                        style="@style/Text.VoiceLock.titleS"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:fontFamily="@font/sora_medium"
                        android:text="@string/display_over_other_apps"
                        android:textColor="@color/primary_text"
                        app:layout_constraintBottom_toTopOf="@id/tvDisplayDesc"
                        app:layout_constraintEnd_toStartOf="@id/swDisplay"
                        app:layout_constraintStart_toEndOf="@id/ivIconDisplayContainer"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tvDisplayDesc"
                        style="@style/Text.VoiceLock.bodyS"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:fontFamily="@font/sora_regular"
                        android:text="@string/display_over_other_apps_desc"
                        android:textColor="@color/textSecondary"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tvDisplayTitle"
                        app:layout_constraintStart_toStartOf="@id/tvDisplayTitle"
                        app:layout_constraintTop_toBottomOf="@id/tvDisplayTitle" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/display_over_other_apps"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:thumbTint="@drawable/selector_permission_thumb_card"
                        app:trackDecorationTint="@android:color/transparent"
                        app:trackTint="@drawable/selector_permission_track_card" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/btnContinue"
        style="@style/Text.VoiceLock.buttonL"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginBottom="@dimen/spacing_xxl"
        android:background="@drawable/bg_cta_gradient"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/sora_semibold"
        android:gravity="center"
        android:text="@string/continue_text"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
