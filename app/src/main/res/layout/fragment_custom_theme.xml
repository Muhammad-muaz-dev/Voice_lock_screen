<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp" android:padding="12dp" android:background="@drawable/bg_header_circle_dark" android:src="@drawable/ic_pin_back" android:contentDescription="@string/back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/lock_screen_themes" android:textSize="@dimen/text_titleL" android:fontFamily="@font/sora_semibold" android:textColor="@color/textPrimary" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="24dp" android:background="@drawable/bg_card_dark">
        <ImageView android:id="@+id/image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@string/preview" />
        <TextView android:id="@+id/clock" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="24dp" android:gravity="center" android:fontFamily="@font/sora_bold" android:textSize="@dimen/text_clock" android:textColor="@color/textPrimary" />
        <TextView android:id="@+id/quote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_margin="24dp" android:gravity="center" android:padding="16dp" android:background="@drawable/bg_card_dark" android:textSize="@dimen/text_bodyM" android:textColor="@color/textPrimary" />
    </FrameLayout>
    <TextView android:id="@+id/btnChange" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="16dp" android:gravity="center" android:text="@string/change_picture" android:background="@drawable/bg_outline_button" android:textSize="@dimen/text_buttonL" android:fontFamily="@font/sora_bold" android:textColor="@color/primarySoft" />
    <androidx.appcompat.widget.SwitchCompat android:id="@+id/showClock" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:layout_marginTop="16dp" android:text="@string/show_clock_quote" android:textSize="@dimen/text_bodyL" android:fontFamily="@font/sora_medium" android:textColor="@color/textPrimary" />
    <TextView android:id="@+id/btnApply" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:gravity="center" android:text="@string/use_this_theme" android:background="@drawable/bg_cta_gradient" android:textSize="@dimen/text_buttonL" android:fontFamily="@font/sora_bold" android:textColor="@color/textPrimary" />
</LinearLayout>