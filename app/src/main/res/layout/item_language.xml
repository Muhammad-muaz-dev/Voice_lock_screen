<?xml version="1.0" encoding="utf-8"?>
<!-- Language row: leading flag badge and the language name in a white pill. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/languageContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:background="@drawable/bg_language_picker_row"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:paddingHorizontal="@dimen/spacing_lg"
    android:paddingVertical="@dimen/spacing_lg">

    <com.futurecode.voicelockscreen.ui.view.LanguageFlagView
        android:id="@+id/languageFlag"
        android:layout_width="@dimen/language_flag_size"
        android:layout_height="@dimen/language_flag_size"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvLanguageName"
        style="@style/Text.VoiceLock.titleS"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_lg"
        android:fontFamily="@font/sora_medium"
        android:textColor="@color/primary_text"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/languageFlag"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="English" />
</androidx.constraintlayout.widget.ConstraintLayout>
