<?xml version="1.0" encoding="utf-8"?>
<!--
    Onboarding: Skip (top right), pages (phone illustration, title, body, dots + Next), and a
    native ad at the bottom. When the ad slot is hidden, content uses the full safe area.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/onboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    tools:context=".ui.prelogin.OnboardingFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/onboardContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/onboardAdContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpOnboarding"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="5dp"
            app:layout_constraintBottom_toTopOf="@id/tvOnboardTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btnOnboardSkip"
            style="@style/Text.VoiceLock.titleS"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:padding="8dp"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="@font/sora_medium"
            android:gravity="center"
            android:paddingHorizontal="@dimen/spacing_md"
            android:text="@string/onboarding_skip"
            android:textColor="@color/textSecondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvOnboardTitle"
            style="@style/Text.VoiceLock.headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_sm"
            android:fontFamily="@font/sora_bold"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/onboarding_title_text_size"
            android:lineHeight="@dimen/onboarding_title_line_height"
            app:lineHeight="@dimen/onboarding_title_line_height"
            android:layout_marginBottom="@dimen/spacing_xs"
            app:layout_constraintBottom_toTopOf="@+id/tvOnboardBody"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="@string/onboard_title_1" />

        <TextView
            android:id="@+id/tvOnboardBody"
            style="@style/Text.VoiceLock.bodyL"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_sm"
            android:fontFamily="@font/sora_regular"
            android:gravity="center"
            android:maxLines="2"
            android:layout_marginBottom="@dimen/spacing_xxl"
            android:textColor="@color/textSecondary"
            android:textSize="14sp"
            android:lineHeight="@dimen/onboarding_body_line_height"
            app:lineHeight="@dimen/onboarding_body_line_height"
            app:layout_constraintBottom_toTopOf="@+id/btnOnboardNext"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="@string/onboard_body_1" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dotsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            app:layout_constraintBottom_toBottomOf="@id/btnOnboardNext"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnOnboardNext">

            <View
                android:id="@+id/dot1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_onboard_dot"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/dot2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_onboard_dot"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/dot1"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/dot3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_onboard_dot"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/dot2"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/dot4"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_onboard_dot"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/dot3"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/btnOnboardNext"
            style="@style/Text.VoiceLock.buttonL"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/sora_bold"
            android:gravity="center"
            android:minWidth="104dp"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:text="@string/next"
            android:textColor="@color/primary"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/onboardAdContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_md"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
