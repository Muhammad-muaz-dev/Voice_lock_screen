<?xml version="1.0" encoding="utf-8"?>
<!-- AI Voice Notes list: copy of the reference layout (ad slots removed). -->
<androidx.constraintlayout.widget.ConstraintLayout
    android:clipToPadding="false"
    android:clipChildren="false"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    tools:context=".ui.afterlogin.VoiceNoteFragment">

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="@dimen/vn_dp_44"
        android:layout_height="@dimen/vn_dp_44"
        android:layout_marginStart="@dimen/vn_dp_8"
        android:layout_marginTop="@dimen/vn_dp_8"
        android:contentDescription="@null"
        android:padding="@dimen/vn_dp_10"
        android:src="@drawable/vn_ic_logo_voice_note"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/VN.Title_Large"
        android:textSize="20sp"
        android:layout_width="0dp"
        android:fontFamily="@font/sora_bold"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vn_dp_10"
        android:layout_marginEnd="@dimen/vn_dp_12"
        android:text="@string/vn_ai_voice_note"
        android:textColor="@color/vn_neutral01"
        app:layout_constraintBottom_toBottomOf="@id/ivLogo"
        app:layout_constraintEnd_toStartOf="@id/ivPremium"
        app:layout_constraintStart_toEndOf="@id/ivLogo"
        app:layout_constraintTop_toTopOf="@id/ivLogo" />

    <ImageView
        android:id="@+id/ivPremium"
        android:layout_width="@dimen/vn_dp_30"
        android:layout_height="@dimen/vn_dp_30"
        android:layout_marginEnd="@dimen/vn_dp_8"
        android:contentDescription="@string/upgrade_to_premium"
        android:src="@drawable/vn_ic_iap"
        app:layout_constraintBottom_toBottomOf="@id/ivSettings"
        app:layout_constraintEnd_toStartOf="@id/ivSettings"
        app:layout_constraintTop_toTopOf="@id/ivSettings" />

    <ImageView
        android:id="@+id/ivSettings"
        android:layout_width="@dimen/vn_dp_36"
        android:layout_height="@dimen/vn_dp_36"
        android:layout_marginEnd="@dimen/vn_dp_16"
        android:contentDescription="@string/setting"
        android:src="@drawable/vn_ic_setting"
        app:layout_constraintBottom_toBottomOf="@id/ivLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivLogo" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:clipToPadding="false"
        android:clipChildren="false"
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vn_dp_16"
        android:paddingStart="@dimen/vn_dp_16"
        android:paddingEnd="@dimen/vn_dp_16"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivLogo">

        <View
            android:elevation="@dimen/elevation_card"
            android:id="@+id/frameCreateNew"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/vn_dp__16"
            android:background="@drawable/bg_voice_note_card"
            app:layout_constraintBottom_toBottomOf="@id/tvCreateNew"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:translationZ="@dimen/elevation_card"
            android:id="@+id/tvHeaderTitle"
            style="@style/VN.Text_LG_SemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vn_dp_16"
            android:layout_marginTop="@dimen/vn_dp_16"
            android:drawablePadding="@dimen/vn_dp_2"
            android:gravity="center"
            android:text="@string/vn_text_v"
            android:textColor="@color/textPrimary"
            app:drawableEndCompat="@drawable/vn_ic_mic_white"
            app:drawableTint="@color/primary"
            app:layout_constraintStart_toStartOf="@id/frameCreateNew"
            app:layout_constraintTop_toTopOf="@id/frameCreateNew" />

        <TextView
            android:translationZ="@dimen/elevation_card"
            android:id="@+id/tvHeaderTitle2"
            style="@style/VN.Text_LG_SemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vn_dp_2"
            android:gravity="center"
            android:text="@string/vn_text_ice_note"
            android:textColor="@color/textPrimary"
            app:layout_constraintBottom_toBottomOf="@id/tvHeaderTitle"
            app:layout_constraintStart_toEndOf="@id/tvHeaderTitle"
            app:layout_constraintTop_toTopOf="@id/tvHeaderTitle" />

        <TextView
            android:translationZ="@dimen/elevation_card"
            android:id="@+id/tvDesc"
            style="@style/VN.Text_SM_Regular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vn_dp_4"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:gravity="start"
            android:text="@string/vn_voice_note_desc"
            android:textColor="@color/textSecondary"
            app:layout_constraintEnd_toEndOf="@id/frameCreateNew"
            app:layout_constraintStart_toStartOf="@id/tvHeaderTitle"
            app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle" />

        <TextView
            android:translationZ="@dimen/elevation_card"
            android:id="@+id/tvCreateNew"
            style="@style/VN.Text_MD_Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/vn_dp_20"
            android:background="@drawable/vn_bg_radius_1000_primary01"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="@dimen/vn_dp_16"
            android:paddingTop="@dimen/vn_dp_8"
            android:paddingEnd="@dimen/vn_dp_16"
            android:paddingBottom="@dimen/vn_dp_8"
            android:text="@string/vn_create_new"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="@id/frameCreateNew"
            app:layout_constraintTop_toBottomOf="@id/tvDesc"
            android:layout_marginTop="@dimen/spacing_md" />

        <TextView
            android:id="@+id/tvMyNotes"
            style="@style/VN.Text_LG_SemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vn_dp_20"
            android:drawablePadding="@dimen/vn_dp_8"
            android:gravity="center"
            android:text="@string/vn_my_notes"
            android:textColor="@color/vn_neutral01"
            app:drawableStartCompat="@drawable/vn_ic_note"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/frameCreateNew" />

        <androidx.recyclerview.widget.RecyclerView
            android:clipChildren="false"
            android:paddingTop="@dimen/card_shadow_gutter"
            android:paddingHorizontal="@dimen/card_shadow_gutter"
            android:id="@+id/rvNotes"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vn_dp_8"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/card_shadow_gutter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMyNotes" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupNotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="frameCreateNew,tvHeaderTitle,tvHeaderTitle2,tvDesc,tvCreateNew,tvMyNotes,rvNotes" />

        <ImageView
            android:id="@+id/ivEmptyNote"
            android:layout_width="@dimen/vn_dp_120"
            android:layout_height="@dimen/vn_dp_125"
            android:contentDescription="@null"
            android:src="@drawable/vn_ic_empty_note"
            app:layout_constraintBottom_toTopOf="@id/tvEmptyNote"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvEmptyNote"
            style="@style/VN.Text_MD_Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vn_dp_16"
            android:text="@string/vn_no_voice_notes_yet"
            android:textColor="@color/vn_neutral02"
            app:layout_constraintBottom_toTopOf="@id/tvEmptyNoteDesc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivEmptyNote" />

        <TextView
            android:id="@+id/tvEmptyNoteDesc"
            style="@style/VN.Text_SM_Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vn_dp_4"
            android:text="@string/vn_empty_note_desc"
            android:textColor="@color/vn_neutral05"
            app:layout_constraintBottom_toTopOf="@id/tvCreateNow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEmptyNote" />

        <TextView
            android:id="@+id/tvCreateNow"
            style="@style/VN.Text_MD_Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vn_dp_16"
            android:background="@drawable/vn_bg_radius_1000_primary01"
            android:paddingStart="@dimen/vn_dp_16"
            android:paddingTop="@dimen/vn_dp_8"
            android:paddingEnd="@dimen/vn_dp_16"
            android:paddingBottom="@dimen/vn_dp_8"
            android:text="@string/vn_create_now"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEmptyNoteDesc" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:constraint_referenced_ids="ivEmptyNote,tvEmptyNote,tvEmptyNoteDesc,tvCreateNow" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/include_bottom_tabs"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
