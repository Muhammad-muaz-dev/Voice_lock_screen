<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">

    <ImageView android:id="@+id/imgOnBoarding" android:layout_width="0dp" android:layout_height="0dp"
        android:contentDescription="@null" android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/onboardingCopy"
        tools:src="@drawable/onboarding_voice_midnight" />

    <View android:layout_width="0dp" android:layout_height="@dimen/onboarding_art_fade_height"
        android:background="@drawable/bg_onboarding_art_fade" android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="@id/imgOnBoarding" app:layout_constraintEnd_toEndOf="@id/imgOnBoarding"
        app:layout_constraintBottom_toBottomOf="@id/imgOnBoarding" />

    <LinearLayout android:id="@+id/onboardingCopy" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginBottom="@dimen/spacing_lg"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView android:id="@+id/tvOnBoardingTitle" style="@style/Text.VoiceLock.headline"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="@font/sora_bold" android:gravity="center" android:textColor="@color/textPrimary"
            tools:text="Command with Your\nVoice" />

        <TextView android:id="@+id/tvOnBoardingDescription" style="@style/Text.VoiceLock.bodyL"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md" android:fontFamily="@font/sora_regular"
            android:gravity="center" android:textColor="@color/textSecondary"
            tools:text="Use Your Voice to unlock Phone via Advanced AI Voice Recognition Technology" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
