<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/_18sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingEnd="@dimen/_18sdp"
    android:paddingBottom="@dimen/_20sdp">

    <View
        android:layout_width="@dimen/_42sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:text="@string/pick_security_question"
        android:textColor="#172238"
        android:textSize="@dimen/_15ssp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:text="@string/select_one_question"
        android:textColor="#93A2B7"
        android:textSize="@dimen/_9ssp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQuestions"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_330sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:overScrollMode="never"
        tools:itemCount="8"
        tools:listitem="@layout/item_security_question" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmQuestion"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/bg_onboarding_button"
        android:backgroundTint="@null"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/confirm_question"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/_12ssp" />
</LinearLayout>
