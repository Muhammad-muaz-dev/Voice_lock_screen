<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clickable="true"
    android:focusable="true"
    android:padding="@dimen/spacing_lg">

    <ProgressBar
        android:id="@+id/adLoadingProgress"
        android:layout_width="@dimen/spacing_max"
        android:layout_height="@dimen/spacing_max"
        android:importantForAccessibility="no"
        android:indeterminateTint="@color/primary"
        app:layout_constraintBottom_toTopOf="@id/adLoadingLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/adLoadingLabel"
        style="@style/Text.VoiceLock.titleM"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:accessibilityLiveRegion="polite"
        android:fontFamily="@font/sora_semibold"
        android:gravity="center"
        android:text="@string/loading_fullscreen_ad"
        android:textColor="@color/textPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/adLoadingProgress" />
</androidx.constraintlayout.widget.ConstraintLayout>
