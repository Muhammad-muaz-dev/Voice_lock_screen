<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_xxl">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/ivBack"
            android:layout_width="@dimen/spacing_max"
            android:layout_height="@dimen/spacing_max"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="@dimen/spacing_md"
            android:src="@drawable/ic_arrow_back_line"
            app:tint="@color/textPrimary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/spacing_md" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Text.VoiceLock.titleXL"
            android:textSize="20sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sora_semibold"
            android:textColor="@color/textPrimary"
            android:text="@string/pattern_setup_title"
            android:layout_marginStart="@dimen/spacing_sm"
            app:layout_constraintStart_toEndOf="@id/ivBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivBack"
            app:layout_constraintBottom_toBottomOf="@id/ivBack" />

        <TextView
            android:id="@+id/tvPatternHint"
            style="@style/Text.VoiceLock.bodyM"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sora_regular"
            android:textColor="@color/textPrimary"
            android:background="@drawable/bg_credential_info"
            android:elevation="@dimen/elevation_card"
            android:padding="@dimen/spacing_lg"
            android:text="@string/pattern_setup_info"
            app:layout_constraintTop_toBottomOf="@id/ivBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/spacing_lg" />

        <TextView
            android:id="@+id/tvCreatePattern"
            style="@style/Text.VoiceLock.titleS"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sora_semibold"
            android:textColor="@color/textPrimary"
            android:gravity="center"
            android:accessibilityLiveRegion="polite"
            android:text="@string/pattern_setup_draw"
            android:layout_marginTop="@dimen/spacing_md"
            app:layout_constraintTop_toBottomOf="@id/tvPatternHint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.futurecode.voicelockscreen.ui.custom.PatternLockView
            android:id="@+id/patternView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvCreatePattern"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/spacing_huge"
            app:layout_constraintWidth_max="@dimen/credential_pattern_max_size"
            app:layout_constraintDimensionRatio="H,1:1" />

        <TextView
            android:id="@+id/btnStartOver"
            style="@style/Text.VoiceLock.buttonS"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sora_semibold"
            android:textColor="@color/primary_dark"
            android:minHeight="@dimen/spacing_max"
            android:gravity="center"
            android:background="@drawable/bg_credential_outline"
            android:text="@string/pattern_setup_restart"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/patternView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/spacing_huge" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
