<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/vn_bg_radius_16_white"
    android:paddingStart="@dimen/vn_dp_16"
    android:paddingTop="@dimen/vn_dp_12"
    android:paddingEnd="@dimen/vn_dp_24"
    android:paddingBottom="@dimen/vn_dp_12">

    <ImageView
        android:id="@+id/ivEdit"
        android:layout_width="@dimen/vn_dp_36"
        android:layout_height="@dimen/vn_dp_36"
        android:contentDescription="@null"
        android:padding="@dimen/vn_dp_8"
        android:src="@drawable/vn_ic_edit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvEdit"
        style="@style/VN.Text_MD_Medium"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="center_vertical"
        android:text="@string/vn_edit"
        android:textColor="@color/vn_neutral01"
        app:layout_constraintBottom_toBottomOf="@id/ivEdit"
        app:layout_constraintStart_toEndOf="@id/ivEdit"
        app:layout_constraintTop_toTopOf="@id/ivEdit" />

    <ImageView
        android:id="@+id/ivSummary"
        android:layout_width="@dimen/vn_dp_36"
        android:layout_height="@dimen/vn_dp_36"
        android:layout_marginTop="@dimen/vn_dp_8"
        android:contentDescription="@null"
        android:padding="@dimen/vn_dp_8"
        android:src="@drawable/vn_ic_ai_summary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivEdit" />

    <TextView
        android:id="@+id/tvSummary"
        style="@style/VN.Text_MD_Medium"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="center_vertical"
        android:text="@string/vn_ai_summary"
        android:textColor="@color/vn_primary01"
        app:layout_constraintBottom_toBottomOf="@id/ivSummary"
        app:layout_constraintStart_toEndOf="@id/ivSummary"
        app:layout_constraintTop_toTopOf="@id/ivSummary" />

    <ImageView
        android:id="@+id/ivDelete"
        android:layout_width="@dimen/vn_dp_36"
        android:layout_height="@dimen/vn_dp_36"
        android:layout_marginTop="@dimen/vn_dp_8"
        android:contentDescription="@null"
        android:padding="@dimen/vn_dp_8"
        android:src="@drawable/vn_ic_delete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivSummary" />

    <TextView
        android:id="@+id/tvDelete"
        style="@style/VN.Text_MD_Medium"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="center_vertical"
        android:text="@string/vn_delete"
        android:textColor="@color/vn_warning"
        app:layout_constraintBottom_toBottomOf="@id/ivDelete"
        app:layout_constraintStart_toEndOf="@id/ivDelete"
        app:layout_constraintTop_toTopOf="@id/ivDelete" />

    <View
        android:id="@+id/frameEdit"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="@id/ivEdit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/ivEdit"
        app:layout_constraintTop_toTopOf="@id/ivEdit" />

    <View
        android:id="@+id/frameSummary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="@id/ivSummary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/ivSummary"
        app:layout_constraintTop_toTopOf="@id/ivSummary" />

    <View
        android:id="@+id/frameDelete"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="@id/ivDelete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/ivDelete"
        app:layout_constraintTop_toTopOf="@id/ivDelete" />
</androidx.constraintlayout.widget.ConstraintLayout>
