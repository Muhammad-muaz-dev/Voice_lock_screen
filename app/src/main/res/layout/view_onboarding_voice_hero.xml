<?xml version="1.0" encoding="utf-8"?>
<com.futurecode.voicelockscreen.ui.prelogin.OnboardingVoiceHeroView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:importantForAccessibility="noHideDescendants"
    tools:context=".ui.prelogin.OnboardingFragment">

    <View
        android:id="@+id/voiceHeroGlow"
        android:layout_width="@dimen/onboarding_voice_glow_size"
        android:layout_height="@dimen/onboarding_voice_glow_size"
        android:alpha="0.18"
        android:background="@drawable/bg_onboarding_phone_glow"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/onboardPhone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_onboarding_phone_shell"
        android:clipToOutline="true"
        android:elevation="8dp"
        android:importantForAccessibility="no"
        android:padding="@dimen/onboarding_voice_phone_screen_inset"
        android:rotation="-3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="W,1:1.78"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/onboarding_voice_phone_max_width">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/onboardPhoneScreen"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_onboarding_phone_screen"
            android:clipToOutline="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/onboardPhoneGlow"
                android:layout_width="@dimen/onboarding_voice_glow_size"
                android:layout_height="@dimen/onboarding_voice_glow_size"
                android:alpha="0.48"
                android:background="@drawable/bg_onboarding_phone_glow"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.28" />

            <View
                android:id="@+id/onboardPhoneNotch"
                android:layout_width="@dimen/onboarding_voice_phone_notch_width"
                android:layout_height="@dimen/onboarding_voice_phone_notch_height"
                android:background="@drawable/bg_onboarding_phone_notch"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="@dimen/spacing_sm" />

            <TextClock
                android:id="@+id/onboardPhoneClock"
                style="@style/Text.VoiceLock.clock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_sm"
                android:layout_marginTop="40dp"
                android:fontFamily="@font/sora_semibold"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:gravity="center"
                android:textColor="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="8:02" />

            <TextClock
                android:id="@+id/onboardPhoneDate"
                style="@style/Text.VoiceLock.caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_sm"
                android:format12Hour="EEEE, d MMMM"
                android:format24Hour="EEEE, d MMMM"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/whiteMuted"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/onboardPhoneClock"
                tools:text="Thursday, 26 November" />

            <View
                android:id="@+id/onboardPhoneLockOrb"
                android:layout_width="@dimen/onboarding_voice_phone_lock_size"
                android:layout_height="@dimen/onboarding_voice_phone_lock_size"
                android:background="@drawable/bg_onboarding_phone_lock_orb"
                android:elevation="2dp"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.67" />

            <ImageView
                android:id="@+id/onboardPhoneLockIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:elevation="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_unlock_outline"
                app:layout_constraintBottom_toBottomOf="@id/onboardPhoneLockOrb"
                app:layout_constraintEnd_toEndOf="@id/onboardPhoneLockOrb"
                app:layout_constraintStart_toStartOf="@id/onboardPhoneLockOrb"
                app:layout_constraintTop_toTopOf="@id/onboardPhoneLockOrb" />

            <View
                android:id="@+id/onboardPhoneHomeIndicator"
                android:layout_width="56dp"
                android:layout_height="4dp"
                android:layout_marginBottom="@dimen/spacing_md"
                android:background="@drawable/bg_onboarding_phone_indicator"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/voicePulseRingOuter"
        android:layout_width="@dimen/onboarding_voice_mic_ring_outer"
        android:layout_height="@dimen/onboarding_voice_mic_ring_outer"
        android:alpha="0.35"
        android:background="@drawable/bg_onboarding_mic_ring"
        android:elevation="9dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/voiceMicOrb"
        app:layout_constraintEnd_toEndOf="@id/voiceMicOrb"
        app:layout_constraintStart_toStartOf="@id/voiceMicOrb"
        app:layout_constraintTop_toTopOf="@id/voiceMicOrb" />

    <View
        android:id="@+id/voicePulseRingInner"
        android:layout_width="@dimen/onboarding_voice_mic_ring_inner"
        android:layout_height="@dimen/onboarding_voice_mic_ring_inner"
        android:alpha="0.5"
        android:background="@drawable/bg_onboarding_mic_ring"
        android:elevation="9dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/voiceMicOrb"
        app:layout_constraintEnd_toEndOf="@id/voiceMicOrb"
        app:layout_constraintStart_toStartOf="@id/voiceMicOrb"
        app:layout_constraintTop_toTopOf="@id/voiceMicOrb" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/voicePhraseBubble"
        android:layout_width="@dimen/onboarding_voice_phrase_width"
        android:layout_height="@dimen/onboarding_voice_phrase_height"
        android:background="@drawable/bg_onboarding_phrase_bubble"
        android:elevation="8dp"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.47">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/voiceWaveform"
            android:layout_width="30dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/voiceWaveBar1"
                android:layout_width="3dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_onboarding_wave_bar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/voiceWaveBar2"
                android:layout_width="3dp"
                android:layout_height="15dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_onboarding_wave_bar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/voiceWaveBar1"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/voiceWaveBar3"
                android:layout_width="3dp"
                android:layout_height="22dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_onboarding_wave_bar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/voiceWaveBar2"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/voiceWaveBar4"
                android:layout_width="3dp"
                android:layout_height="15dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_onboarding_wave_bar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/voiceWaveBar3"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/voiceWaveBar5"
                android:layout_width="3dp"
                android:layout_height="8dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_onboarding_wave_bar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/voiceWaveBar4"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/voicePhraseText"
            style="@style/Text.VoiceLock.bodyL"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:ellipsize="end"
            android:fontFamily="@font/sora_semibold"
            android:maxLines="1"
            android:text="@string/onboard_voice_phrase"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/voiceWaveform"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/voiceMicOrb"
        android:layout_width="@dimen/onboarding_voice_mic_size"
        android:layout_height="@dimen/onboarding_voice_mic_size"
        android:background="@drawable/bg_onboarding_mic_orb"
        android:elevation="10dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.62"
        android:layout_marginEnd="@dimen/spacing_xl" />

    <ImageView
        android:id="@+id/voiceMicIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:elevation="11dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/vn_ic_mic_white"
        app:layout_constraintBottom_toBottomOf="@id/voiceMicOrb"
        app:layout_constraintEnd_toEndOf="@id/voiceMicOrb"
        app:layout_constraintStart_toStartOf="@id/voiceMicOrb"
        app:layout_constraintTop_toTopOf="@id/voiceMicOrb" />
</com.futurecode.voicelockscreen.ui.prelogin.OnboardingVoiceHeroView>
